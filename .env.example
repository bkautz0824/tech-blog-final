# Next.js 15 Environment Configuration

# Base URL for the application (required for metadata and sitemap generation)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Next.js 15 Performance Optimizations
NEXT_TELEMETRY_DISABLED=1

# Build optimizations
NODE_ENV=production
ANALYZE=false

# Turbo mode for development (Next.js 15+)
TURBOPACK=1

# RSC and Static Generation optimizations
NEXT_PRIVATE_STANDALONE=true
NEXT_PRIVATE_BUILD_WORKER=true

# Cache optimizations
NEXT_CACHE_REVALIDATE_DEFAULT=3600
NEXT_CACHE_REVALIDATE_ARTICLES=86400

# Advanced Next.js 15 features
NEXT_EXPERIMENTAL_AFTER=true
NEXT_EXPERIMENTAL_PPR=false
NEXT_EXPERIMENTAL_REACT_COMPILER=false

# Database and API configurations (if needed)
# DATABASE_URL=
# API_BASE_URL=

# SEO and Analytics (optional)
# GOOGLE_ANALYTICS_ID=
# GOOGLE_SITE_VERIFICATION=

# Security headers
NEXT_SECURITY_HEADERS=true
NEXT_CSP_ENABLED=false