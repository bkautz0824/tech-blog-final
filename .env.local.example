# Convex Configuration
# Get these values by running: npx convex dev
# Then visit your Convex dashboard: https://dashboard.convex.dev

# Convex Deployment URL (used by server-side functions)
CONVEX_DEPLOYMENT=

# Public Convex URL (used by client-side React components)
NEXT_PUBLIC_CONVEX_URL=

# Revalidation Secret (for on-demand ISR revalidation)
# Generate a random string: openssl rand -base64 32
REVALIDATION_SECRET=

# Optional: Node Environment
NODE_ENV=development
