          border: '2px solid currentColor',
          borderTopColor: 'transparent',
          borderRadius: '50%',
          animation: \`\${keyframes({
            '0%': { transform: 'rotate(0deg)' },
            '100%': { transform: 'rotate(360deg)' },
          })} 1s linear infinite\`,
        },
      },
    },
  },

  defaultVariants: {
    variant: 'primary',
    size: 'md',
  },
});

// Global styles
export const globalStyles = globalCss({
  '*': {
    boxSizing: 'border-box',
