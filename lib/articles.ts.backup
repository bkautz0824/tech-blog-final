**Advanced Email Service Integration:**

```typescript
// lib/email.ts - Comprehensive email service
import { Resend } from 'resend';
import { WelcomeEmail } from '@/emails/welcome-email';
import { PasswordResetEmail } from '@/emails/password-reset-email';
import { NewsletterEmail } from '@/emails/newsletter-email';

const resend = new Resend(process.env.RESEND_API_KEY);

export interface EmailOptions {
  to: string | string[];
  subject: string;
  from?: string;
  replyTo?: string;
  cc?: string[];
  bcc?: string[];
}

export class EmailService {
  private static readonly FROM_ADDRESS = 'noreply@yourapp.com';
  private static readonly REPLY_TO = 'support@yourapp.com';

  static async sendWelcomeEmail(options: {
    to: string;
    username: string;
    loginUrl: string;
    avatarUrl?: string;
  }) {
    try {
      const { data, error } = await resend.emails.send({
        from: this.FROM_ADDRESS,
        to: options.to,
        subject: \`Welcome to Your App, \${options.username}!\`,
        react: WelcomeEmail({
          username: options.username,
          loginUrl: options.loginUrl,
          avatarUrl: options.avatarUrl
        }),
        // Advanced features
        tags: [
          { name: 'category', value: 'welcome' },
          { name: 'user_type', value: 'new' }
        ]
      });

      if (error) {
        console.error('Welcome email failed:', error);
        throw error;
      }

      return data;
    } catch (error) {
      console.error('Email service error:', error);
      throw error;
    }
  }

  static async sendPasswordReset(options: {
    to: string;
    username: string;
    resetUrl: string;
    expiresAt: Date;
  }) {
    const { data, error } = await resend.emails.send({
      from: this.FROM_ADDRESS,
      to: options.to,
      subject: 'Reset your password',
      react: PasswordResetEmail({
        username: options.username,
        resetUrl: options.resetUrl,
        expiresAt: options.expiresAt
      }),
      tags: [
        { name: 'category', value: 'security' },
        { name: 'action', value: 'password_reset' }
      ]
    });

    if (error) throw error;
    return data;
  }

  static async sendBulkNewsletter(options: {
    subscribers: Array<{ email: string; name: string; preferences: string[] }>;
    subject: string;
    content: {
      articles: Array<{
        title: string;
        excerpt: string;
        url: string;
        category: string;
      }>;
    };
  }) {
    // Batch email sending for newsletters
    const batchSize = 100; // Resend's batch limit
    const batches = [];

    for (let i = 0; i < options.subscribers.length; i += batchSize) {
      const batch = options.subscribers.slice(i, i + batchSize);
      batches.push(batch);
    }

    const results = await Promise.allSettled(
      batches.map(async (batch) => {
        const emails = batch.map(subscriber => ({
          from: this.FROM_ADDRESS,
          to: subscriber.email,
          subject: options.subject,
          react: NewsletterEmail({
            name: subscriber.name,
            articles: options.content.articles.filter(article =>
              subscriber.preferences.includes(article.category)
            ),
            unsubscribeUrl: \`https://yourapp.com/unsubscribe?email=\${encodeURIComponent(subscriber.email)}\`
          }),
          tags: [
            { name: 'category', value: 'newsletter' },
            { name: 'batch', value: \`batch_\${batches.indexOf(batch)}\` }
          ]
        }));

        return await resend.batch.send(emails);
      })
    );

    return results;
  }

  static async getEmailAnalytics(emailId: string) {
    // Resend provides webhook data for analytics
    // This would typically be stored in your database
    return {
      delivered: true,
      opened: false,
      clicked: false,
      bounced: false,
      complained: false
    };
  }

  static async verifyDomain(domain: string) {
    try {
      const response = await fetch(\`https://api.resend.com/domains/\${domain}/verify\`, {
        method: 'POST',
        headers: {
          'Authorization': \`Bearer \${process.env.RESEND_API_KEY}\`,
          'Content-Type': 'application/json'
        }
      });

      return await response.json();
    } catch (error) {
      console.error('Domain verification failed:', error);
      throw error;
    }
  }
}

// Webhook handler for email events
export async function handleEmailWebhook(event: {
  type: 'email.sent' | 'email.delivered' | 'email.delivery_delayed' | 'email.complained' | 'email.bounced' | 'email.opened' | 'email.clicked';
  created_at: string;
  data: {
    email_id: string;
    from: string;
    to: string[];
    subject: string;
    tags?: Array<{ name: string; value: string }>;
  };
}) {
  // Store analytics data in your database
  switch (event.type) {
    case 'email.delivered':
      // Update delivery status
      break;
    case 'email.opened':
      // Track open rates
