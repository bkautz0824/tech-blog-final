\`\`\`typescript
// Asset management system for professional illustrations
interface IllustrationAsset {
  id: string
  category: 'hero' | 'feature' | 'empty-state' | 'onboarding'
  style: 'outlined' | 'filled' | 'minimal' | 'detailed'
  formats: ('svg' | 'png' | 'webp')[]
  license: 'commercial' | 'personal'
  metadata: {
    colors: string[]
    tags: string[]
    dimensions: { width: number; height: number }
  }
}

// Next.js component for dynamic illustration loading
import { useState, useEffect } from 'react'
import Image from 'next/image'

interface DynamicIllustrationProps {
  category: string
  style?: string
  className?: string
}

export function DynamicIllustration({
  category,
  style = 'outlined',
  className
}: DynamicIllustrationProps) {
  const [illustration, setIllustration] = useState<IllustrationAsset | null>(null)

  useEffect(() => {
    // Load appropriate illustration based on context
    const loadIllustration = async () => {
      const response = await fetch(\`/api/illustrations?\${new URLSearchParams({
        category,
        style,
        format: 'svg'
      })}\`)
      const asset = await response.json()
      setIllustration(asset)
    }

    loadIllustration()
  }, [category, style])

  if (!illustration) {
    return <div className="animate-pulse bg-gray-200 rounded-lg" />
  }

  return (
    <Image
      src={illustration.url}
      alt={illustration.metadata.description}
      width={illustration.metadata.dimensions.width}
      height={illustration.metadata.dimensions.height}
      className={className}
      priority={category === 'hero'}
    />
  )
}
