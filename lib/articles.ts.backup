    this.character.bottom = bottom
    return this
  }

  setAppearance(skin: HumaaansCharacter['skin'], hair: HumaaansCharacter['hair']) {
    this.character.skin = skin
    this.character.hair = hair
    return this
  }

  addAccessories(accessories: HumaaansCharacter['accessories']) {
    this.character.accessories = accessories
    return this
  }

  build(): string {
    // Generate character URL based on selections
    return \`/illustrations/humaaans/\${Object.entries(this.character)
      .filter(([_, value]) => value !== undefined)
      .map(([key, value]) => \`\${key}-\${Array.isArray(value) ? value.join('-') : value}\`)
      .join('_')}.svg\`
  }
}

// Usage in component
export function CustomCharacterBuilder() {
  const [characterUrl, setCharacterUrl] = useState<string>('')

  const generateCharacter = () => {
    const character = new CharacterBuilder()
      .setBody('standing')
      .setClothing('hoodie', 'jeans')
      .setAppearance('medium', 'curly')
      .addAccessories(['glasses', 'bag'])
      .build()

    setCharacterUrl(character)
  }

  return (
    <div className="character-builder">
      <button onClick={generateCharacter} className="btn-primary">
        Generate Character
      </button>
      {characterUrl && (
        <img src={characterUrl} alt="Custom character" className="character-preview" />
      )}
    </div>
  )
}
\`\`\`

## Design Philosophy and Taste Development

### Understanding "How to Develop Taste"

Developing design taste isn't about following trends—it's about understanding fundamental principles that create lasting, effective design. This systematic approach to taste development transforms intuitive decisions into informed design choices.

**The Four Pillars of Design Taste:**

1. **Historical Context**: Understanding design evolution and timeless principles
2. **Functional Analysis**: Recognizing why certain designs work better than others
3. **Cultural Awareness**: Appreciating how context shapes design effectiveness
4. **Iterative Refinement**: Continuously improving through practice and feedback

\`\`\`typescript
// Design evaluation framework
interface DesignEvaluation {
  functionality: {
    usability: number      // 1-10 scale
    accessibility: number  // 1-10 scale
    performance: number    // 1-10 scale
  }
  aesthetics: {
    harmony: number        // Visual balance
    innovation: number     // Creative approach
    appropriateness: number // Context fit
  }
  impact: {
    memorability: number   // Lasting impression
    emotional_response: number // User connection
    brand_alignment: number    // Strategic fit
  }
}

class DesignTasteAnalyzer {
  evaluateDesign(design: any): DesignEvaluation {
    return {
      functionality: this.assessFunctionality(design),
      aesthetics: this.assessAesthetics(design),
      impact: this.assessImpact(design)
    }
  }

  private assessFunctionality(design: any): DesignEvaluation['functionality'] {
    // Analyze usability patterns, accessibility compliance, performance metrics
    return {
      usability: this.calculateUsabilityScore(design),
      accessibility: this.calculateAccessibilityScore(design),
      performance: this.calculatePerformanceScore(design)
    }
  }

  private assessAesthetics(design: any): DesignEvaluation['aesthetics'] {
    // Evaluate visual hierarchy, color harmony, typography choices
    return {
      harmony: this.calculateHarmonyScore(design),
      innovation: this.calculateInnovationScore(design),
      appropriateness: this.calculateAppropriatenessScore(design)
    }
  }

  private assessImpact(design: any): DesignEvaluation['impact'] {
    // Measure emotional response, brand alignment, memorable elements
    return {
      memorability: this.calculateMemorabilityScore(design),
      emotional_response: this.calculateEmotionalScore(design),
      brand_alignment: this.calculateBrandScore(design)
    }
  }
}
\`\`\`

### Building Design Intuition Through Analysis

The best designers aren't born with taste—they develop it through systematic analysis and deliberate practice:

\`\`\`typescript
// Daily design analysis practice
interface DailyDesignPractice {
  date: string
  designs_analyzed: {
    url: string
    category: 'web' | 'mobile' | 'print' | 'branding'
    strengths: string[]
    weaknesses: string[]
    lessons_learned: string[]
  }[]
  insights: string[]
  improvements_identified: string[]
}

// Practice tracker for developing design taste
export class DesignTasteDevelopment {
  private practiceLog: DailyDesignPractice[] = []

  logDailyPractice(practice: DailyDesignPractice) {
    this.practiceLog.push(practice)
    this.identifyPatterns()
  }

  private identifyPatterns() {
    // Analyze trends in what works and what doesn't
    const recentPractice = this.practiceLog.slice(-30) // Last 30 days

    const strengthPatterns = this.extractPatterns(
      recentPractice.flatMap(p => p.designs_analyzed.flatMap(d => d.strengths))
    )

    const weaknessPatterns = this.extractPatterns(
      recentPractice.flatMap(p => p.designs_analyzed.flatMap(d => d.weaknesses))
    )

    return { strengthPatterns, weaknessPatterns }
  }

  private extractPatterns(items: string[]): Record<string, number> {
    return items.reduce((acc, item) => {
      acc[item] = (acc[item] || 0) + 1
      return acc
    }, {} as Record<string, number>)
  }

  generatePersonalDesignPrinciples(): string[] {
    const patterns = this.identifyPatterns()
    // Convert patterns into actionable design principles
    return Object.entries(patterns.strengthPatterns)
      .sort(([,a], [,b]) => b - a)
      .slice(0, 10)
      .map(([principle]) => principle)
  }
}
\`\`\`

## Professional Design System Architecture

### Web Interface Guidelines and Standards

Modern design systems go beyond component libraries—they're comprehensive design languages that scale across teams and products. Drawing inspiration from systems like Vercel's design language, here's how to build scalable design infrastructure:

\`\`\`typescript
// Comprehensive design system architecture
interface DesignSystem {
  foundations: {
    colors: ColorPalette
    typography: TypographyScale
    spacing: SpacingScale
    elevation: ElevationSystem
    motion: MotionSystem
  }
  components: ComponentLibrary
  patterns: DesignPatterns
  guidelines: UsageGuidelines
}

interface ColorPalette {
  primary: {
    50: string   // Lightest
    100: string
    200: string
    300: string
    400: string
    500: string  // Base
    600: string
    700: string
    800: string
    900: string  // Darkest
    950: string  // Deepest
  }
  semantic: {
    success: string
    warning: string
    error: string
    info: string
  }
  neutral: {
    white: string
    gray: Record<50 | 100 | 200 | 300 | 400 | 500 | 600 | 700 | 800 | 900 | 950, string>
    black: string
  }
}

