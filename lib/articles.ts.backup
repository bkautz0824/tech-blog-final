// Component for diverse character representation
interface CharacterProps {
  pose: 'standing' | 'sitting' | 'waving' | 'working'
  style: 'outlined' | 'filled'
  accessories?: ('glasses' | 'hat' | 'bag')[]
  clothing?: 'casual' | 'business' | 'creative'
}

export function InclusiveCharacter({
  pose,
  style,
  accessories = [],
  clothing = 'casual'
}: CharacterProps) {
  const characterUrl = \`/illustrations/openpeeps/\${pose}-\${style}-\${clothing}\${
    accessories.length ? \`-\${accessories.join('-')}\` : ''
  }.svg\`

  return (
    <div className="character-container">
      <img
        src={characterUrl}
        alt={\`Person in \${pose} pose\`}
        className="character-illustration"
      />
    </div>
  )
}
