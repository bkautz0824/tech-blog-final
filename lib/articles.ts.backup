### Git Workflow Optimization

\`\`\`bash
# Professional Git workflow automation
#!/bin/bash

# Pre-commit hooks
setup_git_hooks() {
  # Install husky for Git hooks
  npx husky install

  # Pre-commit: lint, format, test
  npx husky add .husky/pre-commit "npm run lint && npm run format && npm run test:staged"

  # Pre-push: full test suite
  npx husky add .husky/pre-push "npm run test:ci"

  # Commit message validation
  npx husky add .husky/commit-msg "npx commitlint --edit"
}

# Branch naming conventions
create_feature_branch() {
  local feature_name=$1
  local branch_name="feature/${feature_name}"

  git checkout main
  git pull origin main
  git checkout -b "$branch_name"

  echo "Created feature branch: $branch_name"
}

# Automated PR creation
create_pull_request() {
  local title=$1
  local description=$2

  git push origin "$(git branch --show-current)"
  gh pr create --title "$title" --body "$description" --assignee @me
}
\`\`\`

