# Kubernetes deployment for scalable MCP infrastructure
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mcp-orchestrator
  labels:
    app: mcp-orchestrator
spec:
  replicas: 3
  selector:
    matchLabels:
      app: mcp-orchestrator
  template:
    metadata:
      labels:
        app: mcp-orchestrator
    spec:
      containers:
      - name: orchestrator
