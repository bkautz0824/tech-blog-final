}

// TanStack Router + Query integration
const tanstackConfig: TanStackConfig = {
  router: {
    version: '1.x',
    features: ['type-safe-params', 'code-splitting', 'preloading'],
    fileBasedRouting: true
  },
  query: {
    version: '5.x',
