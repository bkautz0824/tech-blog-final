// hooks/use-offline-sync.ts - Offline-first mobile patterns
import { useEffect, useState } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';
import NetInfo from '@react-native-netinfo/netinfo';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';

interface OfflineSyncOptions {
  key: string;
  queryFn: () => Promise<any>;
  enabled?: boolean;
}

export function useOfflineSync({ key, queryFn, enabled = true }: OfflineSyncOptions) {
  const [isOnline, setIsOnline] = useState(true);
  const [cachedData, setCachedData] = useState(null);
  const queryClient = useQueryClient();

  // Monitor network status
  useEffect(() => {
    const unsubscribe = NetInfo.addEventListener(state => {
      setIsOnline(state.isConnected ?? false);
    });

    return unsubscribe;
  }, []);

  // Load cached data on mount
  useEffect(() => {
    async function loadCachedData() {
      try {
        const cached = await AsyncStorage.getItem(\`cache_\${key}\`);
        if (cached) {
          setCachedData(JSON.parse(cached));
        }
      } catch (error) {
        console.error('Failed to load cached data:', error);
      }
    }

    loadCachedData();
  }, [key]);

  const query = useQuery({
    queryKey: [key],
    queryFn,
    enabled: enabled && isOnline,
    onSuccess: async (data) => {
      // Cache successful responses
      try {
        await AsyncStorage.setItem(\`cache_\${key}\`, JSON.stringify(data));
        setCachedData(data);
      } catch (error) {
        console.error('Failed to cache data:', error);
      }
    }
  });

  // Return cached data when offline
  if (!isOnline && cachedData) {
    return {
      ...query,
      data: cachedData,
      isLoading: false,
      isOffline: true
    };
  }

  return {
    ...query,
    isOffline: !isOnline
  };
}

// Optimistic updates for mobile
export function useOptimisticMutation() {
  const queryClient = useQueryClient();
  const [isOnline, setIsOnline] = useState(true);
  const [pendingMutations, setPendingMutations] = useState<any[]>([]);

  useEffect(() => {
    const unsubscribe = NetInfo.addEventListener(state => {
      const wasOffline = !isOnline;
      const isNowOnline = state.isConnected ?? false;

      setIsOnline(isNowOnline);

      // Sync pending mutations when coming back online
      if (wasOffline && isNowOnline && pendingMutations.length > 0) {
        syncPendingMutations();
      }
    });

    return unsubscribe;
  }, [isOnline, pendingMutations]);

  const syncPendingMutations = async () => {
    for (const mutation of pendingMutations) {
      try {
        await mutation.mutationFn(mutation.variables);
      } catch (error) {
        console.error('Failed to sync mutation:', error);
      }
    }
    setPendingMutations([]);
  };

  return { isOnline, pendingMutations };
}
```

**Real-time Chat Implementation:**

```tsx
// components/chat/mobile-chat.tsx - Mobile chat with Convex
import React, { useEffect, useRef } from 'react';
import { FlatList, TextInput, TouchableOpacity, Text, View } from 'react-native';
import { useQuery, useMutation } from 'convex/react';
import { api } from '../convex/_generated/api';
import { Id } from '../convex/_generated/dataModel';

interface MobileChatProps {
  channelId: Id<"channels">;
}

export function MobileChat({ channelId }: MobileChatProps) {
  const [message, setMessage] = React.useState('');
  const flatListRef = useRef<FlatList>(null);

  // Real-time messages query
  const messages = useQuery(api.messages.list, { channelId });
  const sendMessage = useMutation(api.messages.send);

  // Auto-scroll to bottom when new messages arrive
  useEffect(() => {
    if (messages && messages.length > 0) {
      flatListRef.current?.scrollToEnd({ animated: true });
    }
  }, [messages]);

  const handleSend = async () => {
    if (!message.trim()) return;

    const messageText = message.trim();
    setMessage('');

    try {
      await sendMessage({
        channelId,
        text: messageText,
        userId: "current_user_id" as Id<"users">
      });
    } catch (error) {
      console.error('Failed to send message:', error);
      // Could implement retry logic here
    }
  };

  const renderMessage = ({ item }: { item: any }) => (
    <View className="p-4 border-b border-gray-200">
      <View className="flex-row items-center mb-2">
        <Text className="font-semibold text-gray-900">
          {item.author?.username || 'Unknown User'}
        </Text>
        <Text className="text-xs text-gray-500 ml-2">
          {new Date(item.createdAt).toLocaleTimeString()}
        </Text>
      </View>
      <Text className="text-gray-800">{item.text}</Text>
    </View>
  );

  return (
    <View className="flex-1 bg-white">
      <FlatList
        ref={flatListRef}
        data={messages || []}
        keyExtractor={(item) => item._id}
        renderItem={renderMessage}
        className="flex-1"
      />

      <View className="flex-row items-center p-4 border-t border-gray-200">
        <TextInput
          value={message}
          onChangeText={setMessage}
          placeholder="Type a message..."
          className="flex-1 border border-gray-300 rounded-lg px-4 py-2 mr-3"
          multiline
          maxLength={1000}
        />

        <TouchableOpacity
          onPress={handleSend}
          disabled={!message.trim()}
          className="bg-blue-600 px-6 py-2 rounded-lg disabled:opacity-50"
        >
          <Text className="text-white font-medium">Send</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
}
```

## Performance Optimization and Best Practices

### Edge Computing and Global Distribution

Modern BaaS solutions leverage edge computing to minimize latency and improve user experience globally. Understanding how to optimize for edge deployment is crucial for production applications.

**Edge-Optimized Database Queries:**

```typescript
// lib/edge-optimized-queries.ts
import { supabase } from '@/lib/supabase/client';
import { Redis } from '@upstash/redis';

const redis = new Redis({
  url: process.env.UPSTASH_REDIS_REST_URL!,
  token: process.env.UPSTASH_REDIS_REST_TOKEN!
});

// Geographic query optimization
export async function getContentByRegion(region: string, userId?: string) {
  const cacheKey = \`content:\${region}:\${userId || 'anonymous'}\`;

  // Try cache first
  const cached = await redis.get(cacheKey);
  if (cached) {
    return cached;
  }

  // Query with region-specific optimization
  let query = supabase
    .from('content')
    .select(\`
      *,
      content_regions!inner (
        region
      )
    \`)
    .eq('content_regions.region', region)
    .eq('published', true)
    .order('priority', { ascending: false })
    .limit(50);

  // Add user-specific filtering if authenticated
  if (userId) {
    query = query.or(\`
      visibility.eq.public,
      and(visibility.eq.private,author_id.eq.\${userId})
    \`);
  } else {
    query = query.eq('visibility', 'public');
  }

  const { data, error } = await query;

  if (!error && data) {
    // Cache for 5 minutes at the edge
    await redis.setex(cacheKey, 300, data);
  }

  return data;
}

// Connection pooling for high-traffic applications
export class DatabasePool {
  private static instance: DatabasePool;
  private connections: Map<string, any> = new Map();

  static getInstance() {
    if (!DatabasePool.instance) {
      DatabasePool.instance = new DatabasePool();
    }
    return DatabasePool.instance;
  }

  async getConnection(region: string) {
    if (!this.connections.has(region)) {
      const client = createClient(
        process.env[\`SUPABASE_URL_\${region.toUpperCase()}\`]!,
        process.env[\`SUPABASE_KEY_\${region.toUpperCase()}\`]!,
        {
          db: {
            schema: 'public'
          },
          auth: {
            autoRefreshToken: false,
            persistSession: false
          }
        }
      );

      this.connections.set(region, client);
    }

    return this.connections.get(region);
  }
}
```

### Security and Compliance Patterns

**Advanced Row Level Security:**

```sql
-- Advanced RLS patterns for multi-tenant applications
create policy "tenant_isolation"
  on posts for all
  using (
    -- Admin users can access all data
    (auth.jwt() ->> 'role' = 'admin')
    or
    -- Regular users only access their tenant's data
    (
      auth.jwt() ->> 'tenant_id' = tenant_id::text
      and
      (
        -- Public posts within tenant
        visibility = 'public'
        or
        -- Private posts owned by user
        (visibility = 'private' and author_id = auth.uid())
        or
        -- Shared posts where user is a collaborator
        exists (
          select 1 from post_collaborators
          where post_id = posts.id
          and user_id = auth.uid()
          and permission in ('read', 'write')
        )
      )
    )
  );

-- Dynamic policies based on subscription level
create policy "subscription_based_access"
  on premium_features for select
  using (
    exists (
      select 1 from user_subscriptions us
      join subscription_plans sp on us.plan_id = sp.id
      where us.user_id = auth.uid()
      and us.status = 'active'
      and us.expires_at > now()
      and sp.features @> array[feature_name]
    )
  );
```

**Data Validation and Sanitization:**

```typescript
// lib/validation.ts - Comprehensive data validation
import { z } from 'zod';
import DOMPurify from 'dompurify';
import { rateLimit } from '@/lib/rate-limit';

// Content validation schemas
export const postContentSchema = z.object({
  title: z.string()
    .min(1, 'Title required')
    .max(200, 'Title too long')
    .regex(/^[^<>]*$/, 'HTML not allowed in title'),

  content: z.string()
    .min(1, 'Content required')
    .max(50000, 'Content too long')
    .transform((content) => {
      // Sanitize HTML content
      return DOMPurify.sanitize(content, {
        ALLOWED_TAGS: ['p', 'br', 'strong', 'em', 'u', 'h1', 'h2', 'h3', 'ul', 'ol', 'li', 'a', 'img'],
        ALLOWED_ATTR: ['href', 'src', 'alt', 'title']
      });
    }),

  tags: z.array(
    z.string()
      .min(1)
      .max(50)
      .regex(/^[a-zA-Z0-9-_]+$/, 'Invalid tag format')
  ).max(10, 'Too many tags'),

  metadata: z.object({
    category: z.enum(['tech', 'business', 'design', 'other']),
    readTime: z.number().min(1).max(60),
    difficulty: z.enum(['beginner', 'intermediate', 'advanced']).optional()
  }).optional()
});

// Rate limiting with different tiers
export async function validateAndRateLimit(
  userId: string,
  action: string,
  data: any,
  schema: z.ZodSchema
) {
  // Rate limiting based on user tier
  const userTier = await getUserTier(userId);
  const limits = {
    'free': { posts: 5, comments: 50 },
    'pro': { posts: 50, comments: 500 },
    'enterprise': { posts: -1, comments: -1 } // Unlimited
  };

  const limit = limits[userTier][action];
  if (limit > 0) {
    const success = await rateLimit(\`\${userId}:\${action}\`, limit, 3600); // Per hour
    if (!success) {
      throw new Error('Rate limit exceeded');
    }
  }

  // Validate data
  const validatedData = schema.parse(data);

  return validatedData;
}

async function getUserTier(userId: string): Promise<'free' | 'pro' | 'enterprise'> {
  // Query user subscription from database
  const { data } = await supabase
    .from('user_subscriptions')
    .select('subscription_plans(tier)')
    .eq('user_id', userId)
    .eq('status', 'active')
    .single();

  return data?.subscription_plans?.tier || 'free';
}
```

## Conclusion

The modern BaaS ecosystem represents a fundamental shift in how we approach full-stack development. By leveraging these powerful platforms and tools, developers can focus on building unique features and exceptional user experiences rather than managing infrastructure and reinventing common functionality.

**Key Takeaways:**

1. **Real-time First**: Modern applications expect real-time updates. Convex's reactive architecture sets the standard for how this should work.

2. **Developer Experience Matters**: Tools like Better Auth and Resend prove that great APIs and developer experience lead to better applications and faster development cycles.

3. **Integration Over Isolation**: The Better T Stack approach demonstrates the power of thoughtfully integrated tools working together rather than disparate solutions.

4. **Edge Computing is Essential**: Global performance requires edge-optimized solutions like Supabase's global distribution and Vercel's serverless platform.

5. **Mobile-First Backend**: Solutions like Convexpo show that backend services must be designed with mobile applications as first-class citizens.

6. **Security by Design**: Modern BaaS platforms provide sophisticated security features like RLS and multi-tenant isolation out of the box.

The tools covered in this article represent the current state of the art in BaaS solutions. As the ecosystem continues to evolve, we can expect even more powerful abstractions and integrations that further reduce the complexity of building modern applications while maintaining the flexibility and performance that developers demand.

Whether you're building a startup MVP or an enterprise application, these platforms provide the foundation for scalable, maintainable, and performant full-stack applications that can compete in today's demanding market.`,
