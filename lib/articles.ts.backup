### End-to-End Testing with Playwright

\`\`\`typescript
// E2E testing configuration
import { test, expect, Page } from '@playwright/test';

class UserJourney {
  constructor(private page: Page) {}

  async signUp(email: string, password: string) {
    await this.page.goto('/signup');
    await this.page.fill('[data-testid=email-input]', email);
    await this.page.fill('[data-testid=password-input]', password);
    await this.page.click('[data-testid=submit-button]');
    await expect(this.page).toHaveURL('/dashboard');
  }

  async createProject(projectName: string) {
    await this.page.click('[data-testid=new-project-button]');
    await this.page.fill('[data-testid=project-name-input]', projectName);
    await this.page.click('[data-testid=create-project-button]');

    await expect(
      this.page.locator(\`[data-testid=project-card]:has-text("\${projectName}")\`)
    ).toBeVisible();
  }
}

test.describe('Complete user journey', () => {
  test('user can sign up and create first project', async ({ page }) => {
    const journey = new UserJourney(page);
    const testEmail = \`test-\${Date.now()}@example.com\`;

    await journey.signUp(testEmail, 'SecurePassword123!');
    await journey.createProject('My First Project');
  });
});
