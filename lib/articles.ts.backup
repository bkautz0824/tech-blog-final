## DeepGraph MCP: Interactive Knowledge Graphs

DeepGraph MCP transforms code repositories into interactive knowledge graphs, enabling AI agents to understand complex codebases through semantic relationships and structural analysis.

### Knowledge Graph Generation

\`\`\`typescript
// DeepGraph MCP server for code analysis
import { AST } from 'typescript';
import { Graph, Node, Edge } from 'graphology';

interface CodeNode {
  id: string;
  type: 'function' | 'class' | 'interface' | 'module' | 'variable';
  name: string;
  file: string;
  lineStart: number;
  lineEnd: number;
  metadata: Record<string, any>;
}

interface CodeRelation {
  source: string;
  target: string;
  type: 'calls' | 'imports' | 'extends' | 'implements' | 'uses';
  weight: number;
}

class DeepGraphMCPServer extends BaseMCPServer {
  private knowledgeGraph = new Graph<CodeNode, CodeRelation>();
  private codeAnalyzer = new TypeScriptAnalyzer();

  constructor() {
    super('deepgraph-mcp', '1.0.0');
  }

  protected getTools(): Tool[] {
    return [
      {
        name: 'analyze_repository',
        description: 'Analyze a code repository and build knowledge graph',
        inputSchema: {
          type: 'object',
          properties: {
            path: { type: 'string' },
            includeTests: { type: 'boolean', default: false },
            maxDepth: { type: 'number', default: 10 }
          },
          required: ['path']
        }
      },
      {
        name: 'query_graph',
        description: 'Query the knowledge graph with semantic search',
        inputSchema: {
          type: 'object',
          properties: {
            query: { type: 'string' },
            nodeTypes: { type: 'array', items: { type: 'string' } },
            relationTypes: { type: 'array', items: { type: 'string' } }
          },
          required: ['query']
        }
      },
      {
        name: 'find_dependencies',
        description: 'Find dependencies and dependents of a code element',
        inputSchema: {
          type: 'object',
          properties: {
            elementId: { type: 'string' },
            depth: { type: 'number', default: 3 },
            direction: { type: 'string', enum: ['incoming', 'outgoing', 'both'] }
          },
          required: ['elementId']
        }
      }
    ];
  }

  protected async handleToolCall(name: string, args: any) {
    switch (name) {
      case 'analyze_repository':
        return this.analyzeRepository(args.path, args);
      case 'query_graph':
        return this.queryGraph(args.query, args);
      case 'find_dependencies':
        return this.findDependencies(args.elementId, args);
      default:
        throw new Error(\`Unknown tool: \${name}\`);
    }
  }

  private async analyzeRepository(path: string, options: any) {
    const files = await this.scanCodebase(path);
    const analysisResults = [];

    for (const file of files) {
      const analysis = await this.codeAnalyzer.analyzeFile(file);
      this.addToKnowledgeGraph(analysis);
      analysisResults.push(analysis);
    }

    return {
      totalFiles: files.length,
      totalNodes: this.knowledgeGraph.order,
      totalEdges: this.knowledgeGraph.size,
      summary: this.generateGraphSummary()
    };
  }

  private async queryGraph(query: string, options: any) {
    // Implement semantic search over the knowledge graph
    const embeddings = await this.generateQueryEmbedding(query);
    const candidates = this.findSimilarNodes(embeddings);

    return {
      results: candidates.map(node => ({
        node: this.knowledgeGraph.getNodeAttributes(node),
        relevance: this.calculateRelevance(node, query),
        context: this.getNodeContext(node)
      }))
    };
  }

  private generateGraphSummary() {
    const nodeTypes = new Map<string, number>();
    const relationTypes = new Map<string, number>();

    this.knowledgeGraph.forEachNode((node, attributes) => {
      nodeTypes.set(attributes.type, (nodeTypes.get(attributes.type) || 0) + 1);
    });

    this.knowledgeGraph.forEachEdge((edge, attributes) => {
      relationTypes.set(attributes.type, (relationTypes.get(attributes.type) || 0) + 1);
    });

    return { nodeTypes: Object.fromEntries(nodeTypes), relationTypes: Object.fromEntries(relationTypes) };
  }
}
\`\`\`

### Advanced Code Analysis Pipeline

\`\`\`typescript
// Sophisticated TypeScript code analyzer
class TypeScriptAnalyzer {
  private program: ts.Program;
  private checker: ts.TypeChecker;

  async analyzeFile(filePath: string): Promise<FileAnalysis> {
    const sourceFile = this.program.getSourceFile(filePath);
    if (!sourceFile) throw new Error(\`File not found: \${filePath}\`);

    const analysis: FileAnalysis = {
      filePath,
      nodes: [],
      relations: [],
      complexity: 0,
      maintainabilityIndex: 0
    };

    const visitor = (node: ts.Node) => {
      switch (node.kind) {
        case ts.SyntaxKind.FunctionDeclaration:
          analysis.nodes.push(this.analyzeFunctionDeclaration(node as ts.FunctionDeclaration));
          break;
        case ts.SyntaxKind.ClassDeclaration:
          analysis.nodes.push(this.analyzeClassDeclaration(node as ts.ClassDeclaration));
          break;
        case ts.SyntaxKind.InterfaceDeclaration:
          analysis.nodes.push(this.analyzeInterfaceDeclaration(node as ts.InterfaceDeclaration));
          break;
        case ts.SyntaxKind.CallExpression:
          analysis.relations.push(this.analyzeCallExpression(node as ts.CallExpression));
          break;
      }

      ts.forEachChild(node, visitor);
    };

    visitor(sourceFile);

    analysis.complexity = this.calculateCyclomaticComplexity(sourceFile);
    analysis.maintainabilityIndex = this.calculateMaintainabilityIndex(analysis);

    return analysis;
  }

  private analyzeFunctionDeclaration(node: ts.FunctionDeclaration): CodeNode {
    const symbol = this.checker.getSymbolAtLocation(node.name!);
    const type = this.checker.getTypeOfSymbolAtLocation(symbol!, node);

    return {
      id: this.generateNodeId(node),
      type: 'function',
      name: node.name?.text || 'anonymous',
      file: node.getSourceFile().fileName,
      lineStart: node.getStart(),
      lineEnd: node.getEnd(),
      metadata: {
        parameters: node.parameters.map(p => ({
          name: p.name.getText(),
          type: this.checker.typeToString(this.checker.getTypeAtLocation(p))
        })),
        returnType: this.checker.typeToString(type),
        isAsync: !!(node.modifiers?.find(m => m.kind === ts.SyntaxKind.AsyncKeyword)),
        isExported: this.isExported(node),
        documentation: this.getDocumentation(symbol)
      }
    };
  }
}
\`\`\`

## Nanobot: Rich Agent Framework

Nanobot transforms MCP servers into rich, interactive agents with advanced conversation handling, memory management, and task orchestration capabilities.

### Agent Architecture

\`\`\`typescript
// Nanobot agent framework
interface AgentConfig {
  name: string;
  personality: string;
  capabilities: string[];
  memoryStrategy: 'volatile' | 'persistent' | 'hybrid';
  mcpServers: string[];
}

class NanobotAgent {
  private config: AgentConfig;
  private memory: AgentMemory;
  private conversationManager: ConversationManager;
  private toolRegistry: ToolRegistry;

  constructor(config: AgentConfig) {
    this.config = config;
    this.memory = new AgentMemory(config.memoryStrategy);
    this.conversationManager = new ConversationManager();
    this.toolRegistry = new ToolRegistry();

    this.initializeMCPServers();
  }

  async processMessage(message: string, context: ConversationContext): Promise<AgentResponse> {
    // Store incoming message in memory
    await this.memory.store('conversation', {
      timestamp: Date.now(),
      role: 'user',
      content: message,
      context
    });

    // Analyze message intent
    const intent = await this.analyzeIntent(message, context);

    // Generate response using appropriate tools
    const response = await this.generateResponse(intent, context);

    // Store response in memory
    await this.memory.store('conversation', {
      timestamp: Date.now(),
      role: 'assistant',
      content: response.content,
      toolsUsed: response.toolsUsed
    });

    return response;
  }

  private async analyzeIntent(message: string, context: ConversationContext): Promise<Intent> {
    const recentHistory = await this.memory.retrieve('conversation', { limit: 10 });

    return {
      primary: await this.classifyIntent(message),
      confidence: await this.calculateIntentConfidence(message, recentHistory),
      entities: await this.extractEntities(message),
      requiredTools: await this.identifyRequiredTools(message, context)
    };
  }

  private async generateResponse(intent: Intent, context: ConversationContext): Promise<AgentResponse> {
    const toolResults: ToolResult[] = [];

    // Execute required tools in order
    for (const toolName of intent.requiredTools) {
      const tool = await this.toolRegistry.getTool(toolName);
      const result = await tool.execute(intent.entities, context);
      toolResults.push(result);
    }

    // Synthesize final response
    const response = await this.synthesizeResponse(intent, toolResults, context);

    return {
      content: response,
      toolsUsed: intent.requiredTools,
      confidence: intent.confidence,
      metadata: {
        processingTime: Date.now() - context.timestamp,
        memoryAccess: await this.memory.getAccessLog()
      }
    };
  }
}
\`\`\`

### Advanced Memory Management

\`\`\`typescript
// Sophisticated agent memory system
class AgentMemory {
  private shortTermMemory = new Map<string, any[]>();
  private longTermMemory: VectorDatabase;
  private memoryStrategy: string;

  constructor(strategy: string) {
    this.memoryStrategy = strategy;
    this.longTermMemory = new VectorDatabase({
      dimensions: 1536,
      metric: 'cosine'
    });
  }

  async store(category: string, data: any): Promise<void> {
    // Short-term storage
    if (!this.shortTermMemory.has(category)) {
      this.shortTermMemory.set(category, []);
    }

    const categoryMemory = this.shortTermMemory.get(category)!;
    categoryMemory.push({
      ...data,
      id: this.generateMemoryId(),
      timestamp: Date.now()
    });

    // Maintain short-term memory size
    if (categoryMemory.length > 100) {
      const transferred = categoryMemory.splice(0, 50);
      await this.transferToLongTerm(category, transferred);
    }

    // Long-term storage for important memories
    if (this.shouldPersist(data)) {
      await this.persistToLongTerm(category, data);
    }
  }

  async retrieve(category: string, options: RetrievalOptions = {}): Promise<any[]> {
    const results: any[] = [];

    // Search short-term memory
    if (this.shortTermMemory.has(category)) {
      const shortTerm = this.shortTermMemory.get(category)!;
      results.push(...this.filterMemories(shortTerm, options));
    }

    // Search long-term memory if needed
    if (options.includeLongTerm) {
      const longTerm = await this.searchLongTermMemory(category, options);
      results.push(...longTerm);
    }

    return this.sortMemories(results, options.sortBy || 'timestamp');
  }

  private async searchLongTermMemory(category: string, options: RetrievalOptions): Promise<any[]> {
    if (options.semanticQuery) {
      const embedding = await this.generateEmbedding(options.semanticQuery);
      return await this.longTermMemory.search(embedding, {
        filter: { category },
        limit: options.limit || 10
      });
    }

    return await this.longTermMemory.query({
      filter: { category },
      limit: options.limit || 10
    });
  }

  async consolidateMemories(): Promise<void> {
    // Periodic memory consolidation
    for (const [category, memories] of this.shortTermMemory.entries()) {
      const consolidated = await this.identifyImportantMemories(memories);
      await this.transferToLongTerm(category, consolidated);
    }
  }
}
\`\`\`

## Chrome Extension Integration

The Chrome extension for Claude Code/Codex provides direct access to web page elements, enabling agents to interact with web applications and extract structured data.

### Browser Automation Framework

\`\`\`typescript
// Chrome extension for AI agent browser integration
class ClaudeCodeExtension {
  private pageAnalyzer: PageAnalyzer;
  private elementExtractor: ElementExtractor;
  private actionExecutor: ActionExecutor;

  constructor() {
    this.pageAnalyzer = new PageAnalyzer();
    this.elementExtractor = new ElementExtractor();
    this.actionExecutor = new ActionExecutor();

    this.initializeContentScript();
  }

  private initializeContentScript() {
    // Inject content script into active pages
    chrome.tabs.onUpdated.addListener((tabId, changeInfo, tab) => {
      if (changeInfo.status === 'complete' && tab.url) {
        chrome.scripting.executeScript({
          target: { tabId },
          func: this.injectClaudeCodeAPI
        });
      }
    });

    // Set up message handling
    chrome.runtime.onMessage.addListener(this.handleAgentRequest.bind(this));
  }

  private async handleAgentRequest(request: AgentRequest): Promise<AgentResponse> {
    const { action, target, params } = request;

    switch (action) {
      case 'analyze_page':
        return this.analyzePage(params.tabId);
      case 'extract_elements':
        return this.extractElements(params.selector, params.tabId);
      case 'execute_action':
        return this.executeAction(target, params);
      case 'monitor_changes':
        return this.monitorChanges(params.selectors, params.tabId);
      default:
        throw new Error(\`Unknown action: \${action}\`);
    }
  }

  private async analyzePage(tabId: number): Promise<PageAnalysis> {
    const results = await chrome.scripting.executeScript({
      target: { tabId },
      func: () => {
        const analyzer = new (window as any).ClaudePageAnalyzer();
        return analyzer.analyze();
      }
    });

    return results[0].result;
  }

  private async extractElements(selector: string, tabId: number): Promise<ExtractedElement[]> {
    const results = await chrome.scripting.executeScript({
      target: { tabId },
      func: (sel) => {
        const extractor = new (window as any).ClaudeElementExtractor();
        return extractor.extract(sel);
      },
      args: [selector]
    });

    return results[0].result;
  }
}
\`\`\`

### Page Analysis and Element Extraction

\`\`\`typescript
// Advanced page analysis for AI agents
class PageAnalyzer {
  analyze(): PageAnalysis {
    const analysis: PageAnalysis = {
      url: window.location.href,
      title: document.title,
      structure: this.analyzeStructure(),
      interactive: this.findInteractiveElements(),
      content: this.extractContent(),
      performance: this.analyzePerformance(),
      accessibility: this.analyzeAccessibility()
    };

    return analysis;
  }

  private analyzeStructure(): StructureAnalysis {
    const headings = this.extractHeadings();
    const sections = this.identifySections();
    const navigation = this.findNavigation();

    return {
      headings,
      sections,
      navigation,
      hierarchy: this.buildContentHierarchy(headings, sections)
    };
  }

  private findInteractiveElements(): InteractiveElement[] {
    const selectors = [
      'button', 'input', 'select', 'textarea',
      '[role="button"]', '[tabindex]', 'a[href]'
    ];

    const elements: InteractiveElement[] = [];

    selectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(element => {
        elements.push({
          type: this.getElementType(element),
          selector: this.generateSelector(element),
          text: this.getElementText(element),
          attributes: this.extractAttributes(element),
          position: this.getElementPosition(element),
          visible: this.isElementVisible(element),
          accessible: this.checkAccessibility(element)
        });
      });
    });

    return elements;
  }

  private extractContent(): ContentAnalysis {
    const textContent = this.extractTextContent();
    const media = this.findMediaElements();
    const data = this.extractStructuredData();

    return {
      text: textContent,
      media,
      structuredData: data,
      readingTime: this.calculateReadingTime(textContent),
      language: this.detectLanguage(textContent)
    };
  }

  private generateSelector(element: Element): string {
    // Generate unique CSS selector for element
    const path: string[] = [];
    let current: Element | null = element;

    while (current && current !== document.body) {
      let selector = current.tagName.toLowerCase();

      if (current.id) {
        selector += \`#\${current.id}\`;
        path.unshift(selector);
        break;
      }

      if (current.className) {
        const classes = Array.from(current.classList)
          .filter(cls => !cls.startsWith('_') && cls.length < 20)
          .slice(0, 3);
        if (classes.length > 0) {
          selector += \`.\${classes.join('.')}\`;
        }
      }

      // Add position-based selector if needed
      const parent = current.parentElement;
      if (parent) {
        const siblings = Array.from(parent.children).filter(
          sibling => sibling.tagName === current!.tagName
        );
        if (siblings.length > 1) {
          const index = siblings.indexOf(current) + 1;
          selector += \`:nth-of-type(\${index})\`;
        }
      }

      path.unshift(selector);
      current = current.parentElement;
    }

    return path.join(' > ');
  }
}
\`\`\`

## Essential MCP Server Collection

The "10 MCP servers are almost all you'll ever need" collection provides a curated set of essential servers covering the most common AI agent use cases.

### Core MCP Servers Setup

\`\`\`typescript
// Essential MCP server collection configuration
interface MCPServerCollection {
  filesystem: FileSystemMCPServer;
  database: DatabaseMCPServer;
  web: WebScrapingMCPServer;
  email: EmailMCPServer;
  calendar: CalendarMCPServer;
  documents: DocumentMCPServer;
  api: APIClientMCPServer;
  monitoring: MonitoringMCPServer;
  deployment: DeploymentMCPServer;
  analytics: AnalyticsMCPServer;
}

class EssentialMCPCollection {
  private servers: MCPServerCollection;
  private orchestrator: MCPOrchestrator;

  constructor() {
    this.servers = this.initializeServers();
    this.orchestrator = new MCPOrchestrator(Object.values(this.servers));
  }

  private initializeServers(): MCPServerCollection {
    return {
      filesystem: new FileSystemMCPServer({
        allowedPaths: ['/workspace', '/tmp'],
        permissions: ['read', 'write', 'execute'],
        maxFileSize: '100MB'
      }),

      database: new DatabaseMCPServer({
        connections: {
          postgresql: process.env.DATABASE_URL,
          redis: process.env.REDIS_URL,
          mongodb: process.env.MONGO_URL
        },
        queryTimeout: 30000,
        maxConnections: 10
      }),

      web: new WebScrapingMCPServer({
        userAgent: 'ClaudeCode Agent/1.0',
        respectRobots: true,
        rateLimit: { requests: 100, per: 'hour' },
        timeout: 30000
      }),

      email: new EmailMCPServer({
        providers: ['smtp', 'sendgrid', 'ses'],
        templates: this.loadEmailTemplates(),
        trackingEnabled: true
      }),

      calendar: new CalendarMCPServer({
        providers: ['google', 'outlook', 'caldav'],
        timeZone: 'UTC',
        reminderDefaults: { minutes: [15, 60] }
      }),

      documents: new DocumentMCPServer({
        supportedFormats: ['pdf', 'docx', 'txt', 'md', 'html'],
        ocrEnabled: true,
        indexingEnabled: true
      }),

      api: new APIClientMCPServer({
        authMethods: ['bearer', 'oauth2', 'apikey'],
        retryPolicy: { attempts: 3, backoff: 'exponential' },
        rateLimiting: true
      }),

      monitoring: new MonitoringMCPServer({
        metrics: ['uptime', 'response_time', 'error_rate'],
        alerts: this.configureAlerts(),
        dashboards: true
      }),

      deployment: new DeploymentMCPServer({
        platforms: ['vercel', 'aws', 'gcp', 'azure'],
        environments: ['staging', 'production'],
        rollbackEnabled: true
      }),

      analytics: new AnalyticsMCPServer({
        providers: ['google-analytics', 'mixpanel', 'amplitude'],
        customEvents: true,
        realtime: true
      })
    };
  }

  async executeWorkflow(workflow: AgentWorkflow): Promise<WorkflowResult> {
    return this.orchestrator.execute(workflow);
  }
}
\`\`\`

### Workflow Orchestration

\`\`\`typescript
// Advanced workflow orchestration for MCP servers
class MCPOrchestrator {
  private servers: BaseMCPServer[];
  private workflowEngine: WorkflowEngine;
  private dependencyResolver: DependencyResolver;

  constructor(servers: BaseMCPServer[]) {
    this.servers = servers;
    this.workflowEngine = new WorkflowEngine();
    this.dependencyResolver = new DependencyResolver();
  }

  async execute(workflow: AgentWorkflow): Promise<WorkflowResult> {
    // Validate workflow
    const validation = await this.validateWorkflow(workflow);
    if (!validation.valid) {
      throw new Error(\`Invalid workflow: \${validation.errors.join(', ')}\`);
    }

    // Resolve dependencies and create execution plan
    const executionPlan = await this.dependencyResolver.resolve(workflow.steps);

    // Execute workflow steps
    const results: StepResult[] = [];
    const context = new WorkflowContext();

    for (const step of executionPlan) {
      try {
        const result = await this.executeStep(step, context);
        results.push(result);

        // Update context with step results
        context.addResult(step.id, result);

        // Check for early termination conditions
        if (result.shouldTerminate) {
          break;
        }
      } catch (error) {
        // Handle step failures
        const failureResult = await this.handleStepFailure(step, error, context);
        results.push(failureResult);

        if (step.required && !failureResult.recovered) {
          throw error;
        }
      }
    }

    return {
      workflowId: workflow.id,
      status: this.calculateWorkflowStatus(results),
      steps: results,
      duration: Date.now() - workflow.startTime,
      context: context.serialize()
    };
  }

  private async executeStep(step: WorkflowStep, context: WorkflowContext): Promise<StepResult> {
    const server = this.findServerForTool(step.tool);
    if (!server) {
      throw new Error(\`No server found for tool: \${step.tool}\`);
    }

    // Resolve step parameters from context
    const resolvedParams = this.resolveParameters(step.parameters, context);

    // Execute the tool
    const startTime = Date.now();
    const result = await server.handleToolCall(step.tool, resolvedParams);
    const duration = Date.now() - startTime;

    return {
      stepId: step.id,
      tool: step.tool,
      status: 'success',
      result,
      duration,
      metadata: {
        server: server.name,
        parametersResolved: Object.keys(resolvedParams).length
      }
    };
  }
}
\`\`\`

## Email Automation with Claude Code SDK

The Claude Code SDK enables sophisticated email automation agents that can handle complex workflows, template management, and intelligent routing.

### Email Agent Architecture

\`\`\`typescript
// Advanced email automation agent
class EmailAutomationAgent extends NanobotAgent {
  private emailProcessor: EmailProcessor;
  private templateEngine: TemplateEngine;
  private workflowManager: WorkflowManager;

  constructor(config: EmailAgentConfig) {
    super({
      name: 'EmailAgent',
      personality: 'Professional and efficient email assistant',
      capabilities: ['email_processing', 'template_management', 'workflow_automation'],
      memoryStrategy: 'persistent',
      mcpServers: ['email', 'documents', 'analytics']
    });

    this.emailProcessor = new EmailProcessor(config.emailConfig);
    this.templateEngine = new TemplateEngine(config.templates);
    this.workflowManager = new WorkflowManager(config.workflows);
  }

  async processIncomingEmail(email: IncomingEmail): Promise<EmailProcessingResult> {
    // Analyze email content and intent
    const analysis = await this.analyzeEmail(email);

    // Determine appropriate workflow
    const workflow = await this.workflowManager.selectWorkflow(analysis);

    // Execute workflow
    const result = await this.executeEmailWorkflow(workflow, email, analysis);

    // Log and update metrics
    await this.logProcessingResult(email, result);

    return result;
  }

  private async analyzeEmail(email: IncomingEmail): Promise<EmailAnalysis> {
    return {
      sentiment: await this.analyzeSentiment(email.content),
      intent: await this.classifyIntent(email.subject + ' ' + email.content),
      urgency: this.calculateUrgency(email),
      category: await this.categorizeEmail(email),
      entities: await this.extractEntities(email.content),
      attachments: await this.analyzeAttachments(email.attachments),
      threadContext: await this.getThreadContext(email.threadId)
    };
  }

  private async executeEmailWorkflow(
    workflow: EmailWorkflow,
    email: IncomingEmail,
    analysis: EmailAnalysis
  ): Promise<EmailProcessingResult> {
    const context = new EmailWorkflowContext(email, analysis);

    for (const action of workflow.actions) {
      switch (action.type) {
        case 'auto_reply':
          await this.sendAutoReply(action.config, context);
          break;
        case 'forward':
          await this.forwardEmail(action.config, context);
          break;
        case 'categorize':
          await this.categorizeAndFile(action.config, context);
          break;
        case 'extract_data':
          await this.extractAndStore(action.config, context);
          break;
        case 'schedule_followup':
          await this.scheduleFollowup(action.config, context);
          break;
        case 'create_task':
          await this.createTask(action.config, context);
          break;
      }
    }

    return context.getResult();
  }
}
\`\`\`

### Intelligent Template System

\`\`\`typescript
// Advanced email template system with AI enhancement
class TemplateEngine {
  private templates: Map<string, EmailTemplate>;
  private aiEnhancer: AITemplateEnhancer;
  private personalizationEngine: PersonalizationEngine;

  constructor(templateConfigs: TemplateConfig[]) {
    this.templates = new Map();
    this.aiEnhancer = new AITemplateEnhancer();
    this.personalizationEngine = new PersonalizationEngine();

    this.loadTemplates(templateConfigs);
  }

  async renderTemplate(
    templateId: string,
    context: EmailContext,
    personalization?: PersonalizationData
  ): Promise<RenderedEmail> {
    const template = this.templates.get(templateId);
    if (!template) {
      throw new Error(\`Template not found: \${templateId}\`);
    }

    // AI-enhance template if configured
    let enhancedTemplate = template;
    if (template.aiEnhanced) {
      enhancedTemplate = await this.aiEnhancer.enhance(template, context);
    }

    // Apply personalization
    if (personalization) {
      enhancedTemplate = await this.personalizationEngine.personalize(
        enhancedTemplate,
        personalization
      );
    }

    // Render final email
    const rendered = await this.renderTemplateContent(enhancedTemplate, context);

    return {
      subject: rendered.subject,
      htmlContent: rendered.html,
      textContent: rendered.text,
      metadata: {
        templateId,
        renderTime: Date.now(),
        personalized: !!personalization,
        aiEnhanced: template.aiEnhanced
      }
    };
  }

  private async renderTemplateContent(
    template: EmailTemplate,
    context: EmailContext
  ): Promise<RenderedTemplate> {
    const handlebars = Handlebars.create();

    // Register custom helpers
    this.registerCustomHelpers(handlebars);

    // Compile templates
    const subjectTemplate = handlebars.compile(template.subject);
    const htmlTemplate = handlebars.compile(template.htmlContent);
    const textTemplate = handlebars.compile(template.textContent);

    // Render with context
    return {
      subject: subjectTemplate(context),
      html: htmlTemplate(context),
      text: textTemplate(context)
    };
  }

  private registerCustomHelpers(handlebars: typeof Handlebars) {
    // Date formatting
    handlebars.registerHelper('formatDate', (date: Date, format: string) => {
      return new Intl.DateTimeFormat('en-US', {
        dateStyle: format as any
      }).format(date);
    });

    // Conditional content
    handlebars.registerHelper('ifPersonalized', function(this: any, options) {
      return this.personalization ? options.fn(this) : options.inverse(this);
    });

    // Dynamic content generation
    handlebars.registerHelper('generateContent', async (prompt: string, context: any) => {
      return await this.aiEnhancer.generateContent(prompt, context);
    });

    // Sentiment-based styling
    handlebars.registerHelper('sentimentClass', (sentiment: string) => {
      const classes = {
        positive: 'text-green-600',
        negative: 'text-red-600',
        neutral: 'text-gray-600'
      };
      return classes[sentiment as keyof typeof classes] || 'text-gray-600';
    });
  }
}
\`\`\`

## Domain-Driven Design for AI Agents

Domain-driven design principles applied to AI agent architecture create maintainable, scalable, and domain-focused intelligent systems.

### Domain Model Architecture

\`\`\`typescript
// Domain-driven AI agent architecture
abstract class DomainEntity {
  protected id: string;
  protected version: number;
  protected domainEvents: DomainEvent[];

  constructor(id: string) {
    this.id = id;
    this.version = 0;
    this.domainEvents = [];
  }

  protected addDomainEvent(event: DomainEvent) {
    this.domainEvents.push(event);
  }

  public getUncommittedEvents(): DomainEvent[] {
    return [...this.domainEvents];
  }

  public clearEvents() {
    this.domainEvents = [];
  }
}

// Customer domain entity
class Customer extends DomainEntity {
  private name: string;
  private email: string;
  private preferences: CustomerPreferences;
  private communicationHistory: CommunicationRecord[];

  constructor(id: string, name: string, email: string) {
    super(id);
    this.name = name;
    this.email = email;
    this.preferences = new CustomerPreferences();
    this.communicationHistory = [];
  }

  public addCommunication(record: CommunicationRecord) {
    this.communicationHistory.push(record);
    this.addDomainEvent(new CustomerCommunicationAdded(this.id, record));
  }

  public updatePreferences(preferences: Partial<CustomerPreferences>) {
    const oldPreferences = { ...this.preferences };
    Object.assign(this.preferences, preferences);

    this.addDomainEvent(new CustomerPreferencesUpdated(
      this.id,
      oldPreferences,
      this.preferences
    ));
  }

  public getPersonalizationContext(): PersonalizationContext {
    return {
      customerId: this.id,
      name: this.name,
      preferences: this.preferences,
      recentCommunications: this.communicationHistory.slice(-5),
      communicationStyle: this.inferCommunicationStyle(),
      topics: this.extractTopics()
    };
  }
}

// Agent domain service
class CustomerServiceAgent {
  private customerRepository: CustomerRepository;
  private communicationService: CommunicationService;
  private aiService: AIService;
  private eventBus: EventBus;

  constructor(
    customerRepository: CustomerRepository,
    communicationService: CommunicationService,
    aiService: AIService,
    eventBus: EventBus
  ) {
    this.customerRepository = customerRepository;
    this.communicationService = communicationService;
    this.aiService = aiService;
    this.eventBus = eventBus;
  }

  async handleCustomerInquiry(inquiry: CustomerInquiry): Promise<CustomerResponse> {
    // Load customer aggregate
    const customer = await this.customerRepository.findById(inquiry.customerId);
    if (!customer) {
      throw new DomainError('Customer not found');
    }

    // Get personalization context
    const context = customer.getPersonalizationContext();

    // Generate AI response using domain knowledge
    const aiResponse = await this.aiService.generateResponse(inquiry, context);

    // Create communication record
    const communicationRecord = new CommunicationRecord(
      inquiry.id,
      'inquiry',
      inquiry.content,
      aiResponse.content,
      new Date()
    );

    // Update customer aggregate
    customer.addCommunication(communicationRecord);

    // Save changes
    await this.customerRepository.save(customer);

    // Publish domain events
    const events = customer.getUncommittedEvents();
    for (const event of events) {
      await this.eventBus.publish(event);
    }
    customer.clearEvents();

    return new CustomerResponse(
      aiResponse.content,
      aiResponse.confidence,
      aiResponse.suggestedActions
    );
  }
}
\`\`\`

### Aggregate Root Pattern for Agents

\`\`\`typescript
// Agent aggregate root with business invariants
class ConversationAggregate extends DomainEntity {
  private customerId: string;
  private messages: ConversationMessage[];
  private status: ConversationStatus;
  private metadata: ConversationMetadata;
  private assignedAgent: AgentId | null;

  constructor(customerId: string, initialMessage: string) {
    super(ConversationId.generate());
    this.customerId = customerId;
    this.messages = [];
    this.status = ConversationStatus.ACTIVE;
    this.metadata = new ConversationMetadata();
    this.assignedAgent = null;

    this.addMessage('customer', initialMessage);
    this.addDomainEvent(new ConversationStarted(this.id, customerId));
  }

  public addMessage(role: 'customer' | 'agent', content: string): void {
    // Business rules validation
    this.validateCanAddMessage(role);

    const message = new ConversationMessage(
      MessageId.generate(),
      role,
      content,
      new Date()
    );

    this.messages.push(message);
    this.updateMetadata(message);

    this.addDomainEvent(new MessageAdded(this.id, message));

    // Auto-close conversation if resolved
    if (this.shouldAutoClose(message)) {
      this.close('auto_resolved');
    }
  }

  public assignToAgent(agentId: AgentId): void {
    if (this.status === ConversationStatus.CLOSED) {
      throw new DomainError('Cannot assign closed conversation');
    }

    this.assignedAgent = agentId;
    this.addDomainEvent(new ConversationAssigned(this.id, agentId));
  }

  public escalate(reason: string): void {
    if (this.assignedAgent) {
      throw new DomainError('Conversation already assigned');
    }

    this.status = ConversationStatus.ESCALATED;
    this.metadata.escalationReason = reason;

    this.addDomainEvent(new ConversationEscalated(this.id, reason));
  }

  private validateCanAddMessage(role: string): void {
    if (this.status === ConversationStatus.CLOSED) {
      throw new DomainError('Cannot add message to closed conversation');
    }

    if (role === 'agent' && !this.assignedAgent) {
      throw new DomainError('No agent assigned to conversation');
    }
  }

  private shouldAutoClose(message: ConversationMessage): boolean {
    // Business logic for auto-closing conversations
    return message.role === 'customer' &&
           message.content.toLowerCase().includes('thank you') &&
           this.messages.length > 4;
  }
}
\`\`\`

## Production Deployment and Management

### Container Orchestration

\`\`\`yaml
# Docker Compose for MCP server deployment
version: '3.8'

services:
  mcp-orchestrator:
    build:
      context: .
      dockerfile: Dockerfile.orchestrator
    environment:
      - NODE_ENV=production
      - REDIS_URL=redis://redis:6379
      - DATABASE_URL=postgresql://user:pass@postgres:5432/mcpdb
    ports:
      - "8080:8080"
    depends_on:
      - redis
      - postgres
    volumes:
      - ./config:/app/config
      - mcp-logs:/app/logs

  deepgraph-mcp:
    build:
      context: .
      dockerfile: Dockerfile.deepgraph
    environment:
      - MCP_SERVER_NAME=deepgraph
      - ANALYSIS_CACHE_TTL=3600
    volumes:
      - ./repositories:/app/repositories:ro
      - analysis-cache:/app/cache

  nanobot-agent:
    build:
      context: .
      dockerfile: Dockerfile.nanobot
    environment:
      - AGENT_NAME=production-bot
      - MEMORY_STRATEGY=persistent
      - AI_MODEL=claude-3-sonnet
    volumes:
      - agent-memory:/app/memory
      - ./agent-config:/app/config:ro

  email-agent:
    build:
      context: .
      dockerfile: Dockerfile.email
    environment:
      - SMTP_HOST=\${SMTP_HOST}
      - SMTP_USER=\${SMTP_USER}
      - SMTP_PASS=\${SMTP_PASS}
      - TEMPLATE_CACHE_SIZE=1000
    volumes:
      - ./email-templates:/app/templates:ro

  redis:
    image: redis:7-alpine
    volumes:
      - redis-data:/data

  postgres:
    image: postgres:15-alpine
    environment:
      - POSTGRES_DB=mcpdb
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=pass
    volumes:
      - postgres-data:/var/lib/postgresql/data

volumes:
  redis-data:
  postgres-data:
  mcp-logs:
  analysis-cache:
  agent-memory:
