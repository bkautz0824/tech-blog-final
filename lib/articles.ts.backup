### Spline Timeline and Animation System

**Advanced Timeline Control**
\`\`\`typescript
// Spline Timeline Management
class SplineTimelineController {
  private app: Application
  private timelines: Map<string, any> = new Map()
  private activeTimeline: string | null = null

  constructor(app: Application) {
    this.app = app
    this.initializeTimelines()
  }

  initializeTimelines() {
    // Register custom timeline behaviors
    this.registerTimeline('intro', {
      duration: 3000,
      keyframes: [
        { time: 0, properties: { camera: 'position-1' } },
        { time: 1000, properties: { object: 'fade-in' } },
        { time: 2000, properties: { lighting: 'dramatic' } },
        { time: 3000, properties: { camera: 'position-final' } }
      ]
    })

    this.registerTimeline('product-showcase', {
      duration: 8000,
      loop: true,
      keyframes: [
        { time: 0, properties: { product: 'rotate-start' } },
        { time: 2000, properties: { product: 'zoom-in' } },
        { time: 4000, properties: { product: 'material-change' } },
        { time: 6000, properties: { product: 'zoom-out' } },
        { time: 8000, properties: { product: 'rotate-end' } }
      ]
    })
  }

  registerTimeline(name: string, config: TimelineConfig) {
    this.timelines.set(name, {
      ...config,
      currentTime: 0,
      isPlaying: false,
      direction: 1 // 1 for forward, -1 for reverse
    })
  }

  play(timelineName: string, options?: PlayOptions) {
    const timeline = this.timelines.get(timelineName)
    if (!timeline) return

    this.activeTimeline = timelineName
    timeline.isPlaying = true
    timeline.direction = options?.reverse ? -1 : 1

    // Execute timeline keyframes
    this.executeTimeline(timeline, options)
  }

  private executeTimeline(timeline: any, options?: PlayOptions) {
    const startTime = Date.now()
    const initialTime = timeline.currentTime

    const animate = () => {
      if (!timeline.isPlaying) return

      const elapsed = Date.now() - startTime
      const progress = elapsed / timeline.duration
      timeline.currentTime = initialTime + (elapsed * timeline.direction)

      // Clamp timeline bounds
      if (timeline.currentTime >= timeline.duration) {
        timeline.currentTime = timeline.loop ? 0 : timeline.duration
        if (!timeline.loop) timeline.isPlaying = false
      } else if (timeline.currentTime <= 0) {
        timeline.currentTime = timeline.loop ? timeline.duration : 0
        if (!timeline.loop) timeline.isPlaying = false
      }

      // Apply keyframe properties
      this.applyKeyframe(timeline, timeline.currentTime)

      if (timeline.isPlaying) {
        requestAnimationFrame(animate)
      } else {
        options?.onComplete?.()
      }
    }

    requestAnimationFrame(animate)
  }

  private applyKeyframe(timeline: any, currentTime: number) {
    // Find surrounding keyframes
    const keyframes = timeline.keyframes.sort((a: any, b: any) => a.time - b.time)
    let prevKeyframe = keyframes[0]
    let nextKeyframe = keyframes[keyframes.length - 1]

    for (let i = 0; i < keyframes.length - 1; i++) {
      if (currentTime >= keyframes[i].time && currentTime <= keyframes[i + 1].time) {
        prevKeyframe = keyframes[i]
        nextKeyframe = keyframes[i + 1]
        break
      }
    }

    // Interpolate between keyframes
    const progress = (currentTime - prevKeyframe.time) / (nextKeyframe.time - prevKeyframe.time)
    const easedProgress = this.easeInOutCubic(Math.max(0, Math.min(1, progress)))

    // Apply interpolated properties to Spline objects
    this.interpolateProperties(prevKeyframe.properties, nextKeyframe.properties, easedProgress)
  }

  private easeInOutCubic(t: number): number {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2
  }

  private interpolateProperties(start: any, end: any, progress: number) {
    Object.keys(start).forEach(key => {
      const object = this.app.findObjectByName(key)
      if (!object) return

      const startProps = start[key]
      const endProps = end[key]

      // Handle different property types
      if (typeof startProps === 'object' && startProps.position) {
        object.position.lerp(endProps.position, progress)
      } else if (typeof startProps === 'string') {
        // Handle named animations or states
        if (progress > 0.5) {
          this.app.emitEvent(endProps)
        }
      }
    })
  }
}
\`\`\`

## React Three Fiber Ecosystem and Patterns

### Advanced R3F Component Patterns

React Three Fiber transforms Three.js development by bringing React's declarative paradigm to 3D graphics. This creates opportunities for sophisticated component architectures that leverage React's ecosystem while maintaining high performance.

**Declarative 3D Component System**
\`\`\`typescript
// Advanced R3F Component Patterns
import { forwardRef, useImperativeHandle, useRef } from 'react'
import { useFrame, extend } from '@react-three/fiber'
import { shaderMaterial } from '@react-three/drei'
import * as THREE from 'three'

// Custom Shader Material
const CustomWaveMaterial = shaderMaterial(
  {
    uTime: 0,
    uAmplitude: 0.5,
    uFrequency: 2.0,
    uColor: new THREE.Color(0.2, 0.6, 1.0),
  },
  // Vertex shader
  \`
    varying vec2 vUv;
    varying vec3 vPosition;
    uniform float uTime;
    uniform float uAmplitude;
    uniform float uFrequency;

    void main() {
      vUv = uv;
      vPosition = position;

      vec3 pos = position;
      pos.z += sin(pos.x * uFrequency + uTime) * uAmplitude;
      pos.z += cos(pos.y * uFrequency * 0.5 + uTime * 0.7) * uAmplitude * 0.5;

      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
  \`,
  // Fragment shader
  \`
    varying vec2 vUv;
    varying vec3 vPosition;
    uniform vec3 uColor;
    uniform float uTime;

    void main() {
      float wave = sin(vPosition.x * 10.0 + uTime * 2.0) * 0.5 + 0.5;
      vec3 color = mix(uColor, vec3(1.0, 0.8, 0.2), wave);
      gl_Color = vec4(color, 1.0);
    }
  \`
)

extend({ CustomWaveMaterial })

// Animated Wave Mesh Component
interface WaveMeshProps {
  amplitude?: number
  frequency?: number
  color?: THREE.Color | string
  position?: [number, number, number]
  rotation?: [number, number, number]
  onHover?: (hovered: boolean) => void
  onClick?: () => void
}

export const WaveMesh = forwardRef<THREE.Mesh, WaveMeshProps>(({
  amplitude = 0.5,
  frequency = 2.0,
  color = '#4fc3f7',
  position = [0, 0, 0],
  rotation = [0, 0, 0],
  onHover,
  onClick
}, ref) => {
  const meshRef = useRef<THREE.Mesh>(null)
  const materialRef = useRef<any>(null)

  useImperativeHandle(ref, () => meshRef.current as THREE.Mesh)

  // Animate shader uniforms
  useFrame((state, delta) => {
    if (materialRef.current) {
      materialRef.current.uTime = state.clock.elapsedTime
      materialRef.current.uAmplitude = amplitude
      materialRef.current.uFrequency = frequency
    }
  })

  return (
    <mesh
      ref={meshRef}
      position={position}
      rotation={rotation}
      onPointerOver={() => onHover?.(true)}
      onPointerOut={() => onHover?.(false)}
      onClick={onClick}
    >
      <planeGeometry args={[10, 10, 50, 50]} />
      <customWaveMaterial
        ref={materialRef}
        uColor={typeof color === 'string' ? new THREE.Color(color) : color}
      />
    </mesh>
  )
})

// Complex 3D Scene Composition
interface Scene3DCompositionProps {
  data: Array<{ id: string; position: [number, number, number]; value: number }>
  interactive?: boolean
  theme?: 'light' | 'dark'
  onDataPointSelect?: (id: string) => void
}

export function Scene3DComposition({
  data,
  interactive = true,
  theme = 'light',
  onDataPointSelect
}: Scene3DCompositionProps) {
  const groupRef = useRef<THREE.Group>(null)
  const [hoveredId, setHoveredId] = useState<string | null>(null)
  const [selectedId, setSelectedId] = useState<string | null>(null)

  // Animate scene rotation
  useFrame((state, delta) => {
    if (groupRef.current && !hoveredId) {
      groupRef.current.rotation.y += delta * 0.1
    }
  })

  const handleDataPointInteraction = useCallback((id: string, type: 'hover' | 'select') => {
    if (type === 'hover') {
      setHoveredId(hoveredId === id ? null : id)
    } else {
      setSelectedId(id)
      onDataPointSelect?.(id)
    }
  }, [hoveredId, onDataPointSelect])

  return (
    <group ref={groupRef}>
      {/* Background Environment */}
      <WaveMesh
        position={[0, -5, -10]}
        rotation={[-Math.PI / 2, 0, 0]}
        color={theme === 'dark' ? '#1e293b' : '#f1f5f9'}
        amplitude={0.2}
        frequency={1.0}
      />

      {/* Data Visualization Elements */}
      {data.map((point) => (
        <DataPoint3D
          key={point.id}
          id={point.id}
          position={point.position}
          value={point.value}
          isHovered={hoveredId === point.id}
          isSelected={selectedId === point.id}
          interactive={interactive}
          theme={theme}
          onHover={(hovered) =>
            hovered ? setHoveredId(point.id) : setHoveredId(null)
          }
          onClick={() => handleDataPointInteraction(point.id, 'select')}
        />
      ))}

      {/* Dynamic Connecting Lines */}
      <ConnectionLines
        data={data}
        selectedId={selectedId}
        theme={theme}
      />

      {/* Floating UI Elements */}
      {selectedId && (
        <FloatingInfo3D
          position={data.find(d => d.id === selectedId)?.position || [0, 2, 0]}
          data={data.find(d => d.id === selectedId)}
        />
      )}
    </group>
  )
}
