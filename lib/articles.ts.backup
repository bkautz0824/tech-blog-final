### Advanced Component Architecture

Modern mobile development requires sophisticated component patterns that handle platform differences gracefully while maintaining reusability.

**Universal Button Component with Platform Optimization:**
\`\`\`tsx
// components/universal/Button.tsx
import React from 'react'
import { Platform, Pressable, View } from 'react-native'
import { Button as PaperButton } from 'react-native-paper'
import { Button as TamaguiButton } from 'tamagui'
import Animated, {
  useAnimatedStyle,
  useSharedValue,
  withSpring,
  withTiming
} from 'react-native-reanimated'
import { Haptics, HapticFeedbackStyle } from 'expo-haptics'

interface UniversalButtonProps {
  title: string
  onPress: () => void
  variant?: 'primary' | 'secondary' | 'tertiary'
  size?: 'small' | 'medium' | 'large'
  disabled?: boolean
  loading?: boolean
  haptic?: boolean
  style?: ViewStyle
  testID?: string
}

const AnimatedPressable = Animated.createAnimatedComponent(Pressable)

export const UniversalButton: React.FC<UniversalButtonProps> = ({
  title,
  onPress,
  variant = 'primary',
  size = 'medium',
  disabled = false,
  loading = false,
  haptic = true,
  style,
  testID
}) => {
  const scale = useSharedValue(1)
  const opacity = useSharedValue(1)

  const animatedStyle = useAnimatedStyle(() => ({
    transform: [{ scale: scale.value }],
    opacity: opacity.value,
  }))

  const handlePressIn = () => {
    scale.value = withSpring(0.95, {
      damping: 15,
      stiffness: 200,
    })

    if (haptic && Platform.OS !== 'web') {
      Haptics.impactAsync(HapticFeedbackStyle.Light)
    }
  }

  const handlePressOut = () => {
    scale.value = withSpring(1, {
      damping: 15,
      stiffness: 200,
    })
  }

  const handlePress = () => {
    if (disabled || loading) return

    if (haptic && Platform.OS !== 'web') {
      Haptics.impactAsync(HapticFeedbackStyle.Medium)
    }

    onPress()
  }

  // Platform-specific implementations
  if (Platform.OS === 'web') {
    return (
      <TamaguiButton
        size={size}
        theme={variant}
        onPress={handlePress}
        disabled={disabled || loading}
        style={style}
        testID={testID}
      >
        {loading ? 'Loading...' : title}
      </TamaguiButton>
    )
  }

  return (
    <AnimatedPressable
      style={[animatedStyle, style]}
      onPressIn={handlePressIn}
      onPressOut={handlePressOut}
      onPress={handlePress}
      disabled={disabled || loading}
      testID={testID}
    >
      <PaperButton
        mode={variant === 'primary' ? 'contained' : 'outlined'}
        size={size}
        loading={loading}
        disabled={disabled}
        onPress={() => {}} // Handled by Pressable
      >
        {title}
      </PaperButton>
    </AnimatedPressable>
  )
}
\`\`\`

## Universal UI Systems and Component Libraries

### React Native Paper: Material Design Excellence

React Native Paper provides the most comprehensive Material Design implementation for React Native, offering both Material Design 2 and Material Design 3 support.

**Advanced Form Implementation:**
\`\`\`tsx
// components/forms/MaterialForm.tsx
import React, { useState } from 'react'
import { ScrollView, KeyboardAvoidingView, Platform } from 'react-native'
import {
  TextInput,
  Button,
  Card,
  Title,
  Paragraph,
  HelperText,
  Chip,
  Switch,
  RadioButton,
  Checkbox,
} from 'react-native-paper'
import { useForm, Controller } from 'react-hook-form'
import { z } from 'zod'
import { zodResolver } from '@hookform/resolvers/zod'

const profileSchema = z.object({
  firstName: z.string().min(2, 'First name must be at least 2 characters'),
  lastName: z.string().min(2, 'Last name must be at least 2 characters'),
  email: z.string().email('Invalid email address'),
  phoneNumber: z.string().min(10, 'Phone number must be at least 10 digits'),
  bio: z.string().max(500, 'Bio must be less than 500 characters'),
  notifications: z.boolean(),
  newsletter: z.boolean(),
  theme: z.enum(['light', 'dark', 'auto']),
  interests: z.array(z.string()),
})

type ProfileFormData = z.infer<typeof profileSchema>

const INTEREST_OPTIONS = [
  'Technology', 'Sports', 'Music', 'Travel', 'Food', 'Art', 'Science'
]

export const MaterialForm: React.FC = () => {
  const [interests, setInterests] = useState<string[]>([])

  const {
    control,
    handleSubmit,
    formState: { errors, isSubmitting, isValid },
    reset,
  } = useForm<ProfileFormData>({
    resolver: zodResolver(profileSchema),
    defaultValues: {
      firstName: '',
      lastName: '',
      email: '',
      phoneNumber: '',
      bio: '',
      notifications: true,
      newsletter: false,
      theme: 'auto',
      interests: [],
    },
  })

  const onSubmit = async (data: ProfileFormData) => {
    try {
      // Simulate API call
      await new Promise(resolve => setTimeout(resolve, 2000))
      console.log('Profile updated:', data)
      reset()
    } catch (error) {
      console.error('Failed to update profile:', error)
    }
  }

  const toggleInterest = (interest: string) => {
    setInterests(prev =>
      prev.includes(interest)
        ? prev.filter(i => i !== interest)
        : [...prev, interest]
    )
  }

  return (
    <KeyboardAvoidingView
      style={{ flex: 1 }}
      behavior={Platform.OS === 'ios' ? 'padding' : 'height'}
    >
      <ScrollView contentContainerStyle={{ padding: 16 }}>
        <Card>
          <Card.Content>
            <Title>Profile Information</Title>
            <Paragraph>Update your profile details</Paragraph>

            {/* Name Fields */}
            <Controller
              control={control}
              name="firstName"
              render={({ field: { onChange, onBlur, value } }) => (
                <>
                  <TextInput
                    label="First Name"
                    value={value}
                    onChangeText={onChange}
                    onBlur={onBlur}
                    mode="outlined"
                    error={!!errors.firstName}
                    style={{ marginTop: 16 }}
                  />
                  <HelperText type="error" visible={!!errors.firstName}>
                    {errors.firstName?.message}
                  </HelperText>
                </>
              )}
            />

            <Controller
              control={control}
              name="lastName"
              render={({ field: { onChange, onBlur, value } }) => (
                <>
                  <TextInput
                    label="Last Name"
                    value={value}
                    onChangeText={onChange}
                    onBlur={onBlur}
                    mode="outlined"
                    error={!!errors.lastName}
                    style={{ marginTop: 8 }}
                  />
                  <HelperText type="error" visible={!!errors.lastName}>
                    {errors.lastName?.message}
                  </HelperText>
                </>
              )}
            />

            {/* Contact Fields */}
            <Controller
              control={control}
              name="email"
              render={({ field: { onChange, onBlur, value } }) => (
                <>
                  <TextInput
                    label="Email"
                    value={value}
                    onChangeText={onChange}
                    onBlur={onBlur}
                    mode="outlined"
                    keyboardType="email-address"
                    autoCapitalize="none"
                    error={!!errors.email}
                    style={{ marginTop: 8 }}
                  />
                  <HelperText type="error" visible={!!errors.email}>
                    {errors.email?.message}
                  </HelperText>
                </>
              )}
            />

            {/* Bio Field */}
            <Controller
              control={control}
              name="bio"
              render={({ field: { onChange, onBlur, value } }) => (
                <>
                  <TextInput
                    label="Bio"
                    value={value}
                    onChangeText={onChange}
                    onBlur={onBlur}
                    mode="outlined"
                    multiline
                    numberOfLines={4}
                    maxLength={500}
                    error={!!errors.bio}
                    style={{ marginTop: 8 }}
                  />
                  <HelperText type="info">
                    {value.length}/500 characters
                  </HelperText>
                  <HelperText type="error" visible={!!errors.bio}>
                    {errors.bio?.message}
                  </HelperText>
                </>
              )}
            />

            {/* Interests */}
            <Title style={{ marginTop: 16, fontSize: 16 }}>Interests</Title>
            <View style={{ flexDirection: 'row', flexWrap: 'wrap', marginTop: 8 }}>
              {INTEREST_OPTIONS.map(interest => (
                <Chip
                  key={interest}
                  selected={interests.includes(interest)}
                  onPress={() => toggleInterest(interest)}
                  style={{ margin: 4 }}
                >
                  {interest}
                </Chip>
              ))}
            </View>

            {/* Settings */}
            <Title style={{ marginTop: 16, fontSize: 16 }}>Preferences</Title>

            <Controller
              control={control}
              name="notifications"
              render={({ field: { onChange, value } }) => (
                <View style={{
                  flexDirection: 'row',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  marginTop: 8
                }}>
                  <Paragraph>Push Notifications</Paragraph>
                  <Switch value={value} onValueChange={onChange} />
                </View>
              )}
            />

            <Controller
              control={control}
              name="newsletter"
              render={({ field: { onChange, value } }) => (
                <View style={{
                  flexDirection: 'row',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  marginTop: 8
                }}>
                  <Paragraph>Newsletter</Paragraph>
                  <Checkbox
                    status={value ? 'checked' : 'unchecked'}
                    onPress={() => onChange(!value)}
                  />
                </View>
              )}
            />

            {/* Theme Selection */}
            <Controller
              control={control}
              name="theme"
              render={({ field: { onChange, value } }) => (
                <RadioButton.Group onValueChange={onChange} value={value}>
                  <Title style={{ marginTop: 16, fontSize: 16 }}>Theme</Title>
                  <RadioButton.Item label="Light" value="light" />
                  <RadioButton.Item label="Dark" value="dark" />
                  <RadioButton.Item label="Auto" value="auto" />
                </RadioButton.Group>
              )}
            />

            <Button
              mode="contained"
              onPress={handleSubmit(onSubmit)}
              loading={isSubmitting}
              disabled={!isValid || isSubmitting}
              style={{ marginTop: 24 }}
            >
              Update Profile
            </Button>
          </Card.Content>
        </Card>
      </ScrollView>
    </KeyboardAvoidingView>
  )
}
\`\`\`

### Tamagui: Universal Design System

Tamagui represents the next generation of universal design systems, providing a single codebase that works optimally across React Native and web platforms.

**Advanced Tamagui Component System:**
\`\`\`tsx
// components/tamagui/ProductCard.tsx
import React from 'react'
import {
  Card,
  XStack,
  YStack,
  Text,
  Button,
  Image,
  Avatar,
  Badge,
  Separator,
  useTheme,
} from 'tamagui'
import { Star, ShoppingCart, Heart } from '@tamagui/lucide-icons'
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withSpring,
  withTiming,
  runOnJS
} from 'react-native-reanimated'
import { Gesture, GestureDetector } from 'react-native-gesture-handler'

interface ProductCardProps {
  id: string
  title: string
  price: number
  originalPrice?: number
  rating: number
  reviewCount: number
  imageUrl: string
  category: string
  inStock: boolean
  onAddToCart: (id: string) => void
  onToggleFavorite: (id: string, isFavorite: boolean) => void
  isFavorite: boolean
}

const AnimatedCard = Animated.createAnimatedComponent(Card)

export const ProductCard: React.FC<ProductCardProps> = ({
  id,
  title,
  price,
  originalPrice,
  rating,
  reviewCount,
  imageUrl,
  category,
  inStock,
  onAddToCart,
  onToggleFavorite,
  isFavorite,
}) => {
  const theme = useTheme()
  const scale = useSharedValue(1)
  const favoriteScale = useSharedValue(1)
  const favoriteRotation = useSharedValue(0)

  const cardAnimatedStyle = useAnimatedStyle(() => ({
    transform: [{ scale: scale.value }],
  }))

  const favoriteAnimatedStyle = useAnimatedStyle(() => ({
    transform: [
      { scale: favoriteScale.value },
      { rotate: \`\${favoriteRotation.value}deg\` }
    ],
  }))

  const handleFavoritePress = () => {
    favoriteScale.value = withSpring(0.8, {}, () => {
      favoriteScale.value = withSpring(1)
    })
    favoriteRotation.value = withTiming(isFavorite ? 0 : 360, { duration: 300 })
    runOnJS(onToggleFavorite)(id, !isFavorite)
  }

  const panGesture = Gesture.Pan()
    .onBegin(() => {
      scale.value = withSpring(0.95)
    })
    .onEnd(() => {
      scale.value = withSpring(1)
    })

  const discount = originalPrice ? Math.round(((originalPrice - price) / originalPrice) * 100) : 0

  return (
    <GestureDetector gesture={panGesture}>
      <AnimatedCard
        elevate
        size="$4"
        bordered
        style={cardAnimatedStyle}
        backgroundColor="$background"
        marginBottom="$3"
        overflow="hidden"
      >
        <Card.Header paddingBottom="$2">
          <XStack justifyContent="space-between" alignItems="flex-start">
            <Badge
              size="$2"
              backgroundColor="$blue10"
              color="$blue1"
            >
              {category}
            </Badge>

            <Animated.View style={favoriteAnimatedStyle}>
              <Button
                size="$2"
                circular
                icon={Heart}
                backgroundColor={isFavorite ? "$red10" : "$gray5"}
                color={isFavorite ? "$red1" : "$gray11"}
                onPress={handleFavoritePress}
                borderWidth={0}
              />
            </Animated.View>
          </XStack>
        </Card.Header>

        <YStack padding="$3" space="$2">
          <Image
            source={{ uri: imageUrl }}
            width="100%"
            height={200}
            borderRadius="$2"
            backgroundColor="$gray3"
          />

          <YStack space="$1">
            <Text
              fontSize="$5"
              fontWeight="600"
              color="$color"
              numberOfLines={2}
            >
              {title}
            </Text>

            <XStack alignItems="center" space="$2">
              <XStack alignItems="center" space="$1">
                <Star size={16} color={theme.yellow10.get()} fill={theme.yellow10.get()} />
                <Text fontSize="$3" color="$gray11">
                  {rating.toFixed(1)}
                </Text>
                <Text fontSize="$3" color="$gray10">
                  ({reviewCount})
                </Text>
              </XStack>
            </XStack>

            <XStack alignItems="center" space="$2">
              <Text
                fontSize="$6"
                fontWeight="700"
                color="$color"
              >
                \${price.toFixed(2)}
              </Text>

              {originalPrice && (
                <>
                  <Text
                    fontSize="$4"
                    color="$gray10"
                    textDecorationLine="line-through"
                  >
                    \${originalPrice.toFixed(2)}
                  </Text>
                  <Badge
                    size="$1"
                    backgroundColor="$green10"
                    color="$green1"
                  >
                    -{discount}%
                  </Badge>
                </>
              )}
            </XStack>
          </YStack>

          <Separator marginVertical="$2" />

          <XStack space="$2" justifyContent="space-between">
            <Text
              fontSize="$3"
              color={inStock ? "$green11" : "$red11"}
              fontWeight="500"
            >
              {inStock ? "In Stock" : "Out of Stock"}
            </Text>

            <Button
              size="$3"
              theme="blue"
              iconAfter={ShoppingCart}
              disabled={!inStock}
              onPress={() => onAddToCart(id)}
              backgroundColor={inStock ? "$blue10" : "$gray5"}
              color={inStock ? "$blue1" : "$gray11"}
            >
              Add to Cart
            </Button>
          </XStack>
        </YStack>
      </AnimatedCard>
    </GestureDetector>
  )
}
\`\`\`

### GlueStack UI: Mobile-First Component Architecture

GlueStack UI provides a mobile-first approach to component development with excellent TypeScript support and customization capabilities.

**Advanced GlueStack Implementation:**
\`\`\`tsx
// components/gluestack/DashboardScreen.tsx
import React, { useState, useEffect } from 'react'
import {
  Box,
  VStack,
  HStack,
  Text,
  Button,
  Input,
  InputField,
  Card,
  Avatar,
  AvatarImage,
  Badge,
  BadgeText,
  Spinner,
  Alert,
  AlertIcon,
  AlertText,
  Progress,
  ProgressFilledTrack,
  Modal,
  ModalBackdrop,
  ModalContent,
  ModalHeader,
  ModalBody,
  ModalFooter,
  useToast,
  Toast,
  ToastTitle,
  ToastDescription,
} from '@gluestack-ui/themed'
import { RefreshControl, FlatList } from 'react-native'
import { FlashList } from '@shopify/flash-list'

interface DashboardData {
  stats: {
    totalUsers: number
    activeUsers: number
    revenue: number
    growth: number
  }
  recentActivity: ActivityItem[]
  notifications: Notification[]
}

interface ActivityItem {
  id: string
  user: {
    name: string
    avatar: string
  }
  action: string
  timestamp: Date
  type: 'purchase' | 'signup' | 'review' | 'support'
}

export const DashboardScreen: React.FC = () => {
  const [data, setData] = useState<DashboardData | null>(null)
  const [loading, setLoading] = useState(true)
  const [refreshing, setRefreshing] = useState(false)
  const [showModal, setShowModal] = useState(false)
  const toast = useToast()

  const fetchDashboardData = async () => {
    try {
      // Simulate API call
      await new Promise(resolve => setTimeout(resolve, 1500))

      const mockData: DashboardData = {
        stats: {
          totalUsers: 12458,
          activeUsers: 8934,
          revenue: 156789,
          growth: 12.5,
        },
        recentActivity: [
          {
            id: '1',
            user: { name: 'John Doe', avatar: 'https://i.pravatar.cc/150?img=1' },
            action: 'Made a purchase',
            timestamp: new Date(),
            type: 'purchase'
          },
          // ... more items
        ],
        notifications: [
          // ... notifications
        ]
      }

      setData(mockData)
    } catch (error) {
      toast.show({
        placement: 'top',
        render: ({ id }) => (
          <Toast nativeID={\`toast-\${id}\`} action="error">
            <ToastTitle>Error</ToastTitle>
            <ToastDescription>Failed to load dashboard data</ToastDescription>
          </Toast>
        )
      })
    } finally {
      setLoading(false)
      setRefreshing(false)
    }
  }

  useEffect(() => {
    fetchDashboardData()
  }, [])

  const handleRefresh = () => {
    setRefreshing(true)
    fetchDashboardData()
  }

  const renderStatCard = (title: string, value: string | number, growth?: number) => (
    <Card size="sm" variant="elevated" marginBottom="$3">
      <VStack space="sm">
        <Text fontSize="$sm" color="$textLight600">
          {title}
        </Text>
        <HStack alignItems="center" justifyContent="space-between">
          <Text fontSize="$2xl" fontWeight="$bold">
            {typeof value === 'number' ? value.toLocaleString() : value}
          </Text>
          {growth && (
            <Badge
              size="sm"
              variant="solid"
              action={growth > 0 ? "success" : "error"}
            >
              <BadgeText>
                {growth > 0 ? '+' : ''}{growth}%
              </BadgeText>
            </Badge>
          )}
        </HStack>
      </VStack>
    </Card>
  )

  const renderActivityItem = ({ item }: { item: ActivityItem }) => {
    const getTypeColor = (type: string) => {
      switch (type) {
        case 'purchase': return '$success500'
        case 'signup': return '$info500'
        case 'review': return '$warning500'
        case 'support': return '$error500'
        default: return '$primary500'
      }
    }

    return (
      <Card size="sm" variant="outline" marginBottom="$2">
        <HStack space="md" alignItems="center">
          <Avatar size="md">
            <AvatarImage source={{ uri: item.user.avatar }} />
          </Avatar>

          <VStack flex={1} space="xs">
            <Text fontSize="$sm" fontWeight="$medium">
              {item.user.name}
            </Text>
            <Text fontSize="$xs" color="$textLight600">
              {item.action}
            </Text>
            <Text fontSize="$xs" color="$textLight500">
              {item.timestamp.toLocaleDateString()}
            </Text>
          </VStack>

          <Box
            width="$3"
            height="$3"
            borderRadius="$full"
            backgroundColor={getTypeColor(item.type)}
          />
        </HStack>
      </Card>
    )
  }

  if (loading) {
    return (
      <Box flex={1} justifyContent="center" alignItems="center">
        <Spinner size="large" />
        <Text marginTop="$4">Loading dashboard...</Text>
      </Box>
    )
  }

  return (
    <Box flex={1} backgroundColor="$backgroundLight50">
      <FlatList
        contentContainerStyle={{ padding: 16 }}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={handleRefresh} />
        }
        ListHeaderComponent={
          <VStack space="lg">
            {/* Header */}
            <HStack justifyContent="space-between" alignItems="center">
              <Text fontSize="$2xl" fontWeight="$bold">
                Dashboard
              </Text>
              <Button size="sm" onPress={() => setShowModal(true)}>
                <Text color="white">Settings</Text>
              </Button>
            </HStack>

            {/* Stats Grid */}
            {data && (
              <>
                {renderStatCard("Total Users", data.stats.totalUsers)}
                {renderStatCard("Active Users", data.stats.activeUsers, data.stats.growth)}
                {renderStatCard("Revenue", \`$\${data.stats.revenue.toLocaleString()}\`)}

                {/* Progress Indicator */}
                <Card size="sm" variant="elevated">
                  <VStack space="md">
                    <Text fontSize="$sm" color="$textLight600">
                      Monthly Goal Progress
                    </Text>
                    <Progress value={75} size="md">
                      <ProgressFilledTrack />
                    </Progress>
                    <Text fontSize="$xs" color="$textLight500">
                      75% of monthly revenue goal achieved
                    </Text>
                  </VStack>
                </Card>

                {/* Recent Activity Header */}
                <Text fontSize="$lg" fontWeight="$semibold" marginTop="$4">
                  Recent Activity
                </Text>
              </>
            )}
          </VStack>
        }
        data={data?.recentActivity || []}
        renderItem={renderActivityItem}
        keyExtractor={(item) => item.id}
        showsVerticalScrollIndicator={false}
      />

      {/* Settings Modal */}
      <Modal isOpen={showModal} onClose={() => setShowModal(false)}>
        <ModalBackdrop />
        <ModalContent>
          <ModalHeader>
            <Text fontSize="$lg" fontWeight="$bold">
              Dashboard Settings
            </Text>
          </ModalHeader>
          <ModalBody>
            <VStack space="md">
              <Input>
                <InputField placeholder="Refresh interval (seconds)" />
              </Input>

              <Alert action="info">
                <AlertIcon />
                <AlertText>
                  Changes will take effect after the next refresh
                </AlertText>
              </Alert>
            </VStack>
          </ModalBody>
          <ModalFooter>
            <HStack space="md" justifyContent="flex-end">
              <Button
                variant="outline"
                onPress={() => setShowModal(false)}
              >
                <Text>Cancel</Text>
              </Button>
              <Button onPress={() => setShowModal(false)}>
                <Text color="white">Save</Text>
              </Button>
            </HStack>
          </ModalFooter>
        </ModalContent>
      </Modal>
    </Box>
  )
}
\`\`\`

## Performance Optimization for Mobile Apps

### FlashList Performance Implementation

FlashList provides significant performance improvements over traditional FlatList implementations, especially for large datasets.

**Advanced FlashList with Performance Monitoring:**
\`\`\`tsx
// components/performance/OptimizedList.tsx
import React, { useMemo, useCallback, useState, useRef } from 'react'
import { View, Text, Image, Pressable, Dimensions } from 'react-native'
import { FlashList, ListRenderItem } from '@shopify/flash-list'
import Animated, {
  useAnimatedStyle,
  useSharedValue,
  withTiming,
  runOnJS
} from 'react-native-reanimated'
import { Gesture, GestureDetector } from 'react-native-gesture-handler'

interface ListItem {
  id: string
  title: string
  subtitle: string
  imageUrl: string
  price: number
  rating: number
  category: string
}

interface OptimizedListProps {
  data: ListItem[]
  onItemPress: (item: ListItem) => void
  onEndReached?: () => void
  loading?: boolean
  estimatedItemSize?: number
}

const { width: screenWidth } = Dimensions.get('window')
const ITEM_HEIGHT = 120

export const OptimizedList: React.FC<OptimizedListProps> = ({
  data,
  onItemPress,
  onEndReached,
  loading = false,
  estimatedItemSize = ITEM_HEIGHT
}) => {
  const [visibleRange, setVisibleRange] = useState({ start: 0, end: 10 })
  const flashListRef = useRef<FlashList<ListItem>>(null)
  const lastScrollY = useRef(0)

  // Memoized render item for performance
  const renderItem: ListRenderItem<ListItem> = useCallback(({ item, index }) => {
    return <ListItemComponent
      item={item}
      index={index}
      onPress={onItemPress}
      isVisible={index >= visibleRange.start && index <= visibleRange.end}
    />
  }, [onItemPress, visibleRange])

  // Memoized key extractor
  const keyExtractor = useCallback((item: ListItem) => item.id, [])

  // Optimized getItemType for better recycling
  const getItemType = useCallback((item: ListItem) => {
    return item.category // Group similar items for better recycling
  }, [])

  // Handle viewable items change
  const onViewableItemsChanged = useCallback(({ viewableItems }) => {
    if (viewableItems.length > 0) {
      const start = viewableItems[0].index || 0
      const end = viewableItems[viewableItems.length - 1].index || 0
      setVisibleRange({ start, end })
    }
  }, [])

  // Performance monitoring
  const onMomentumScrollEnd = useCallback((event) => {
    const currentScrollY = event.nativeEvent.contentOffset.y
    const scrollDelta = Math.abs(currentScrollY - lastScrollY.current)

    // Log performance metrics in development
    if (__DEV__) {
      console.log('Scroll performance:', {
        scrollDelta,
        visibleItems: visibleRange.end - visibleRange.start,
        timestamp: Date.now()
      })
    }

    lastScrollY.current = currentScrollY
  }, [visibleRange])

  return (
    <View style={{ flex: 1 }}>
      <FlashList
        ref={flashListRef}
        data={data}
        renderItem={renderItem}
        keyExtractor={keyExtractor}
        getItemType={getItemType}
        estimatedItemSize={estimatedItemSize}
        onViewableItemsChanged={onViewableItemsChanged}
        onMomentumScrollEnd={onMomentumScrollEnd}
        onEndReached={onEndReached}
        onEndReachedThreshold={0.1}
        removeClippedSubviews={true}
        maxToRenderPerBatch={5}
        windowSize={10}
        initialNumToRender={8}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{ paddingHorizontal: 16 }}
      />

      {loading && (
        <View style={{
          position: 'absolute',
          bottom: 20,
          left: 0,
          right: 0,
          alignItems: 'center'
        }}>
          <Text>Loading more...</Text>
        </View>
      )}
    </View>
  )
}

// Optimized list item component
const ListItemComponent: React.FC<{
  item: ListItem
  index: number
  onPress: (item: ListItem) => void
  isVisible: boolean
}> = ({ item, index, onPress, isVisible }) => {
  const scale = useSharedValue(1)
  const opacity = useSharedValue(1)

  const animatedStyle = useAnimatedStyle(() => ({
    transform: [{ scale: scale.value }],
    opacity: opacity.value,
  }))

  const handlePress = () => {
    scale.value = withTiming(0.95, { duration: 100 }, () => {
      scale.value = withTiming(1, { duration: 100 })
    })
    runOnJS(onPress)(item)
  }

  // Only render complex content when visible for performance
  const renderContent = () => {
    if (!isVisible) {
      return <View style={{ height: ITEM_HEIGHT, backgroundColor: '#f5f5f5' }} />
    }

    return (
      <View style={{
        flexDirection: 'row',
        padding: 12,
        backgroundColor: 'white',
        borderRadius: 8,
        marginBottom: 8,
        shadowColor: '#000',
        shadowOffset: { width: 0, height: 2 },
        shadowOpacity: 0.1,
        shadowRadius: 4,
        elevation: 3,
      }}>
        <Image
          source={{ uri: item.imageUrl }}
          style={{
            width: 80,
            height: 80,
            borderRadius: 8,
            backgroundColor: '#f0f0f0'
          }}
          resizeMode="cover"
        />

        <View style={{ flex: 1, marginLeft: 12, justifyContent: 'space-between' }}>
          <View>
            <Text style={{
              fontSize: 16,
              fontWeight: '600',
              color: '#333',
              numberOfLines: 1
            }}>
              {item.title}
            </Text>
            <Text style={{
              fontSize: 14,
              color: '#666',
              marginTop: 4,
              numberOfLines: 2
            }}>
              {item.subtitle}
            </Text>
          </View>

          <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#007AFF' }}>
              \${item.price.toFixed(2)}
            </Text>
            <View style={{ flexDirection: 'row', alignItems: 'center' }}>
              <Text style={{ fontSize: 14, color: '#666' }}>★ {item.rating}</Text>
            </View>
          </View>
        </View>
      </View>
    )
  }

  return (
    <Pressable onPress={handlePress}>
      <Animated.View style={animatedStyle}>
        {renderContent()}
      </Animated.View>
    </Pressable>
  )
}
\`\`\`

## File-Based Routing and Navigation Patterns

### Expo Router Advanced Implementation

Expo Router provides a powerful file-based routing system that brings Next.js-style routing to React Native applications.

**Advanced Expo Router Configuration:**
\`\`\`tsx
// app/_layout.tsx
import React, { useEffect } from 'react'
import { Stack, useRouter, useSegments } from 'expo-router'
import { useAuth } from '../hooks/useAuth'
import { StatusBar } from 'expo-status-bar'
import { GestureHandlerRootView } from 'react-native-gesture-handler'
import { SafeAreaProvider } from 'react-native-safe-area-context'
import { PaperProvider } from 'react-native-paper'
import { TamaguiProvider } from 'tamagui'
import { config } from '../config/tamagui.config'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'

const queryClient = new QueryClient()

export default function RootLayout() {
  const { user, isLoading } = useAuth()
  const segments = useSegments()
  const router = useRouter()

  useEffect(() => {
    if (isLoading) return

    const inAuthGroup = segments[0] === '(auth)'

    if (!user && !inAuthGroup) {
      router.replace('/sign-in')
    } else if (user && inAuthGroup) {
      router.replace('/(tabs)')
    }
  }, [user, segments, isLoading])

  return (
    <QueryClientProvider client={queryClient}>
      <TamaguiProvider config={config}>
        <PaperProvider>
          <SafeAreaProvider>
            <GestureHandlerRootView style={{ flex: 1 }}>
              <Stack
                screenOptions={{
                  headerShown: false,
                  gestureEnabled: true,
                  gestureDirection: 'horizontal',
                  animation: 'slide_from_right',
                }}
              >
                <Stack.Screen name="(tabs)" options={{ headerShown: false }} />
                <Stack.Screen name="(auth)" options={{ headerShown: false }} />
                <Stack.Screen
                  name="modal"
                  options={{
                    presentation: 'modal',
                    gestureEnabled: true,
                    animation: 'slide_from_bottom'
                  }}
                />
              </Stack>
              <StatusBar style="auto" />
            </GestureHandlerRootView>
          </SafeAreaProvider>
        </PaperProvider>
      </TamaguiProvider>
    </QueryClientProvider>
  )
}
\`\`\`

**Advanced Tab Navigation:**
\`\`\`tsx
// app/(tabs)/_layout.tsx
import React from 'react'
import { Tabs } from 'expo-router'
import { useTheme } from 'react-native-paper'
import { Home, Search, ShoppingBag, User } from '@tamagui/lucide-icons'
import { Platform } from 'react-native'

export default function TabLayout() {
  const theme = useTheme()

  return (
    <Tabs
      screenOptions={{
        tabBarActiveTintColor: theme.colors.primary,
        tabBarInactiveTintColor: theme.colors.onSurfaceVariant,
        tabBarStyle: {
          backgroundColor: theme.colors.surface,
          borderTopColor: theme.colors.outline,
          height: Platform.OS === 'ios' ? 88 : 68,
          paddingBottom: Platform.OS === 'ios' ? 24 : 8,
          paddingTop: 8,
        },
        tabBarLabelStyle: {
          fontSize: 12,
          fontWeight: '500',
        },
        headerShown: false,
        tabBarHideOnKeyboard: true,
      }}
    >
      <Tabs.Screen
        name="index"
        options={{
          title: 'Home',
          tabBarIcon: ({ color, size }) => <Home color={color} size={size} />,
        }}
      />
      <Tabs.Screen
        name="search"
        options={{
          title: 'Search',
          tabBarIcon: ({ color, size }) => <Search color={color} size={size} />,
        }}
      />
      <Tabs.Screen
        name="cart"
        options={{
          title: 'Cart',
          tabBarIcon: ({ color, size }) => <ShoppingBag color={color} size={size} />,
          tabBarBadge: '3', // Dynamic badge from state
        }}
      />
      <Tabs.Screen
        name="profile"
        options={{
          title: 'Profile',
          tabBarIcon: ({ color, size }) => <User color={color} size={size} />,
        }}
      />
    </Tabs>
  )
}
\`\`\`

**Dynamic Routes with Parameters:**
\`\`\`tsx
// app/product/[id].tsx
import React, { useEffect, useState } from 'react'
import { ScrollView, View, Image, Dimensions } from 'react-native'
import { Stack, useLocalSearchParams, useRouter } from 'expo-router'
import { Text, Button, Card, Chip, Divider } from 'react-native-paper'
import { SafeAreaView } from 'react-native-safe-area-context'
import { ArrowLeft, Heart, Share, ShoppingCart } from '@tamagui/lucide-icons'
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withTiming,
  interpolate,
  useAnimatedScrollHandler
} from 'react-native-reanimated'

const { width: screenWidth } = Dimensions.get('window')
const HEADER_HEIGHT = 300

export default function ProductScreen() {
  const { id } = useLocalSearchParams<{ id: string }>()
  const router = useRouter()
  const scrollY = useSharedValue(0)
  const [product, setProduct] = useState(null)
  const [loading, setLoading] = useState(true)

  const scrollHandler = useAnimatedScrollHandler({
    onScroll: (event) => {
      scrollY.value = event.contentOffset.y
    },
  })

  const headerAnimatedStyle = useAnimatedStyle(() => {
    const opacity = interpolate(
      scrollY.value,
      [0, HEADER_HEIGHT / 2, HEADER_HEIGHT],
      [0, 0.5, 1],
      'clamp'
    )

    return {
      opacity,
      backgroundColor: 'rgba(255, 255, 255, \${opacity})',
    }
  })

  const imageAnimatedStyle = useAnimatedStyle(() => {
    const scale = interpolate(
      scrollY.value,
      [-100, 0, 100],
      [1.2, 1, 0.8],
      'clamp'
    )

    return {
      transform: [{ scale }],
    }
  })

  useEffect(() => {
    // Fetch product data
    const fetchProduct = async () => {
      try {
        // Simulate API call
        await new Promise(resolve => setTimeout(resolve, 1000))
        setProduct({
          id,
          title: 'Premium Wireless Headphones',
          price: 299.99,
          originalPrice: 399.99,
          description: 'High-quality wireless headphones with noise cancellation...',
          images: ['https://example.com/image1.jpg'],
          rating: 4.5,
          reviewCount: 1234,
          inStock: true,
        })
      } catch (error) {
        console.error('Failed to fetch product:', error)
      } finally {
        setLoading(false)
      }
    }

    fetchProduct()
  }, [id])

  if (loading) {
    return (
      <SafeAreaView style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
        <Text>Loading...</Text>
      </SafeAreaView>
    )
  }

  return (
    <View style={{ flex: 1, backgroundColor: 'white' }}>
      <Stack.Screen
        options={{
          headerShown: true,
          headerTransparent: true,
          headerTitle: '',
          headerLeft: () => (
            <Button
              mode="contained"
              icon={ArrowLeft}
              onPress={() => router.back()}
              style={{ backgroundColor: 'rgba(0,0,0,0.5)' }}
            />
          ),
          headerRight: () => (
            <View style={{ flexDirection: 'row', gap: 8 }}>
              <Button
                mode="contained"
                icon={Heart}
                onPress={() => {}}
                style={{ backgroundColor: 'rgba(0,0,0,0.5)' }}
              />
              <Button
                mode="contained"
                icon={Share}
                onPress={() => {}}
                style={{ backgroundColor: 'rgba(0,0,0,0.5)' }}
              />
            </View>
          ),
        }}
      />

      <Animated.View
        style={[
          {
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            height: 100,
            zIndex: 1,
          },
          headerAnimatedStyle,
        ]}
      />

      <Animated.ScrollView
        onScroll={scrollHandler}
        scrollEventThrottle={16}
        showsVerticalScrollIndicator={false}
      >
        <Animated.View style={[{ height: HEADER_HEIGHT }, imageAnimatedStyle]}>
          <Image
            source={{ uri: product.images[0] }}
            style={{
              width: screenWidth,
              height: HEADER_HEIGHT,
              backgroundColor: '#f5f5f5',
            }}
            resizeMode="cover"
          />
        </Animated.View>

        <View style={{ padding: 16 }}>
          <Text variant="headlineMedium" style={{ marginBottom: 8 }}>
            {product.title}
          </Text>

          <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 16 }}>
            <Text variant="headlineSmall" style={{ color: '#007AFF', fontWeight: 'bold' }}>
              \${product.price}
            </Text>
            {product.originalPrice && (
              <Text
                variant="bodyMedium"
                style={{
                  textDecorationLine: 'line-through',
                  color: '#666',
                  marginLeft: 8
                }}
              >
                \${product.originalPrice}
              </Text>
            )}
            <Chip
              mode="flat"
              style={{
                marginLeft: 'auto',
                backgroundColor: product.inStock ? '#e8f5e8' : '#ffe8e8'
              }}
            >
              {product.inStock ? 'In Stock' : 'Out of Stock'}
            </Chip>
          </View>

          <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 16 }}>
            <Text variant="bodyMedium">★ {product.rating}</Text>
            <Text variant="bodySmall" style={{ color: '#666', marginLeft: 8 }}>
              ({product.reviewCount} reviews)
            </Text>
          </View>

          <Divider style={{ marginVertical: 16 }} />

          <Text variant="titleMedium" style={{ marginBottom: 8 }}>
            Description
          </Text>
          <Text variant="bodyMedium" style={{ lineHeight: 24, color: '#666' }}>
            {product.description}
          </Text>

          <View style={{ height: 100 }} />
        </View>
      </Animated.ScrollView>

      <View style={{
        position: 'absolute',
        bottom: 0,
        left: 0,
        right: 0,
        padding: 16,
        backgroundColor: 'white',
        borderTopWidth: 1,
        borderTopColor: '#e0e0e0',
      }}>
        <Button
          mode="contained"
          icon={ShoppingCart}
          disabled={!product.inStock}
          onPress={() => {
            // Add to cart logic
          }}
          style={{ height: 48 }}
        >
          Add to Cart
        </Button>
      </View>
    </View>
  )
}
\`\`\`

## Mobile Backend Integration Strategies

### Convexpo: Real-Time Data Synchronization

Convexpo provides seamless integration between Convex real-time backend and Expo applications.

**Advanced Convex Integration:**
\`\`\`tsx
// convex/products.ts
import { v } from 'convex/values'
import { query, mutation } from './_generated/server'

export const getProducts = query({
  args: {
    category: v.optional(v.string()),
    search: v.optional(v.string()),
    limit: v.optional(v.number()),
    offset: v.optional(v.number()),
  },
  handler: async (ctx, args) => {
    let query = ctx.db.query('products')

    if (args.category) {
      query = query.filter((q) => q.eq(q.field('category'), args.category))
    }

    if (args.search) {
      query = query.filter((q) =>
        q.or(
          q.eq(q.field('title'), args.search),
          q.eq(q.field('description'), args.search)
        )
      )
    }

    const products = await query
      .order('desc')
      .take(args.limit || 20)

    return products
  },
})

export const addToCart = mutation({
  args: {
    productId: v.id('products'),
    quantity: v.number(),
    userId: v.id('users'),
  },
  handler: async (ctx, args) => {
    const existingItem = await ctx.db
      .query('cart')
      .filter((q) =>
        q.and(
          q.eq(q.field('productId'), args.productId),
          q.eq(q.field('userId'), args.userId)
        )
      )
      .first()

    if (existingItem) {
      return await ctx.db.patch(existingItem._id, {
        quantity: existingItem.quantity + args.quantity,
        updatedAt: Date.now(),
      })
    } else {
      return await ctx.db.insert('cart', {
        productId: args.productId,
        userId: args.userId,
        quantity: args.quantity,
        createdAt: Date.now(),
        updatedAt: Date.now(),
      })
    }
  },
})

export const getCartItems = query({
  args: { userId: v.id('users') },
  handler: async (ctx, args) => {
    const cartItems = await ctx.db
      .query('cart')
      .filter((q) => q.eq(q.field('userId'), args.userId))
      .collect()

    // Join with product data
    const itemsWithProducts = await Promise.all(
      cartItems.map(async (item) => {
        const product = await ctx.db.get(item.productId)
        return {
          ...item,
          product,
        }
      })
    )

    return itemsWithProducts
  },
})
\`\`\`

**Mobile Convex Hook Implementation:**
\`\`\`tsx
// hooks/useConvexData.ts
import { useQuery, useMutation, useAction } from 'convex/react'
import { api } from '../convex/_generated/api'
import { Id } from '../convex/_generated/dataModel'
import { useAuth } from './useAuth'

export const useProducts = (filters?: {
  category?: string
  search?: string
  limit?: number
}) => {
  const products = useQuery(api.products.getProducts, filters || {})

  return {
    products: products || [],
    loading: products === undefined,
    error: null, // Convex handles errors automatically
  }
}

export const useCartItems = () => {
  const { user } = useAuth()
  const cartItems = useQuery(
    api.products.getCartItems,
    user ? { userId: user._id } : 'skip'
  )

  return {
    items: cartItems || [],
    loading: cartItems === undefined,
    totalItems: cartItems?.reduce((sum, item) => sum + item.quantity, 0) || 0,
    totalPrice: cartItems?.reduce((sum, item) =>
      sum + (item.product?.price || 0) * item.quantity, 0
    ) || 0,
  }
}

export const useCartActions = () => {
  const { user } = useAuth()
  const addToCart = useMutation(api.products.addToCart)

  const addItem = async (productId: Id<'products'>, quantity = 1) => {
    if (!user) throw new Error('User not authenticated')

    return await addToCart({
      productId,
      quantity,
      userId: user._id,
    })
  }

  return {
    addToCart: addItem,
  }
}

// Advanced real-time sync hook
export const useRealtimeSync = () => {
  const { user } = useAuth()
  const [syncStatus, setSyncStatus] = useState<'syncing' | 'synced' | 'error'>('synced')

  // Listen for real-time updates
  const cartItems = useQuery(
    api.products.getCartItems,
    user ? { userId: user._id } : 'skip'
  )

  useEffect(() => {
    if (cartItems !== undefined) {
      setSyncStatus('synced')

      // Store in local state for offline access
      AsyncStorage.setItem(
        \`cart_\${user?._id}\`,
        JSON.stringify(cartItems)
      )
    }
  }, [cartItems, user])

  // Handle offline mode
  const [offlineData, setOfflineData] = useState(null)

  useEffect(() => {
    const loadOfflineData = async () => {
      if (!user) return

      try {
        const stored = await AsyncStorage.getItem(\`cart_\${user._id}\`)
        if (stored) {
          setOfflineData(JSON.parse(stored))
        }
      } catch (error) {
        console.error('Failed to load offline data:', error)
      }
    }

    loadOfflineData()
  }, [user])

  return {
    data: cartItems || offlineData,
    syncStatus,
    isOffline: cartItems === undefined && offlineData !== null,
  }
}
\`\`\`

## Mobile-First Design Principles

### Responsive Design Patterns

Modern mobile development requires sophisticated responsive design patterns that adapt to different screen sizes and orientations.

**Advanced Responsive Hook:**
\`\`\`tsx
// hooks/useResponsiveDesign.ts
import { useState, useEffect } from 'react'
import { Dimensions, PixelRatio } from 'react-native'
import { useSafeAreaInsets } from 'react-native-safe-area-context'

interface ScreenDimensions {
  width: number
  height: number
  scale: number
  fontScale: number
}

interface ResponsiveBreakpoints {
  phone: boolean
  tablet: boolean
  desktop: boolean
  isLandscape: boolean
  isPortrait: boolean
}

export const useResponsiveDesign = () => {
  const [dimensions, setDimensions] = useState<ScreenDimensions>(() => {
    const { width, height } = Dimensions.get('window')
    return {
      width,
      height,
      scale: PixelRatio.get(),
      fontScale: PixelRatio.getFontScale(),
    }
  })

  const insets = useSafeAreaInsets()

  useEffect(() => {
    const subscription = Dimensions.addEventListener('change', ({ window }) => {
      setDimensions({
        width: window.width,
        height: window.height,
        scale: PixelRatio.get(),
        fontScale: PixelRatio.getFontScale(),
      })
    })

    return () => subscription?.remove()
  }, [])

  const breakpoints: ResponsiveBreakpoints = {
    phone: dimensions.width < 768,
    tablet: dimensions.width >= 768 && dimensions.width < 1024,
    desktop: dimensions.width >= 1024,
    isLandscape: dimensions.width > dimensions.height,
    isPortrait: dimensions.width <= dimensions.height,
  }

  // Responsive spacing
  const spacing = {
    xs: breakpoints.phone ? 4 : 6,
    sm: breakpoints.phone ? 8 : 12,
    md: breakpoints.phone ? 16 : 20,
    lg: breakpoints.phone ? 24 : 32,
    xl: breakpoints.phone ? 32 : 48,
  }

  // Responsive typography
  const typography = {
    xs: breakpoints.phone ? 12 : 14,
    sm: breakpoints.phone ? 14 : 16,
    md: breakpoints.phone ? 16 : 18,
    lg: breakpoints.phone ? 18 : 24,
    xl: breakpoints.phone ? 24 : 32,
    xxl: breakpoints.phone ? 32 : 48,
  }

  // Grid columns based on screen size
  const gridColumns = breakpoints.phone ? 1 : breakpoints.tablet ? 2 : 3

  // Safe area adjusted dimensions
  const safeAreaDimensions = {
    width: dimensions.width,
    height: dimensions.height - insets.top - insets.bottom,
    contentWidth: dimensions.width - insets.left - insets.right,
  }

  return {
    dimensions,
    safeAreaDimensions,
    breakpoints,
    spacing,
    typography,
    gridColumns,
    insets,
  }
}
\`\`\`

**Responsive Layout Component:**
\`\`\`tsx
// components/layout/ResponsiveGrid.tsx
import React from 'react'
import { View, ScrollView } from 'react-native'
import { useResponsiveDesign } from '../../hooks/useResponsiveDesign'

interface ResponsiveGridProps {
  children: React.ReactNode[]
  spacing?: number
  minItemWidth?: number
  maxColumns?: number
  style?: ViewStyle
}

export const ResponsiveGrid: React.FC<ResponsiveGridProps> = ({
  children,
  spacing = 16,
  minItemWidth = 300,
  maxColumns = 4,
  style,
}) => {
  const { safeAreaDimensions, breakpoints } = useResponsiveDesign()

  // Calculate optimal columns based on screen size and constraints
  const calculateColumns = () => {
    const availableWidth = safeAreaDimensions.contentWidth - (spacing * 2)
    const possibleColumns = Math.floor(availableWidth / minItemWidth)

    if (breakpoints.phone) return 1
    if (breakpoints.tablet) return Math.min(possibleColumns, 2)
    return Math.min(possibleColumns, maxColumns)
  }

  const columns = calculateColumns()
  const itemWidth = (safeAreaDimensions.contentWidth - (spacing * (columns + 1))) / columns

  // Chunk children into rows
  const rows = []
  for (let i = 0; i < children.length; i += columns) {
    rows.push(children.slice(i, i + columns))
  }

  return (
    <ScrollView
      style={style}
      contentContainerStyle={{ padding: spacing }}
      showsVerticalScrollIndicator={false}
    >
      {rows.map((row, rowIndex) => (
        <View
          key={rowIndex}
          style={{
            flexDirection: 'row',
            justifyContent: 'space-between',
            marginBottom: spacing,
          }}
        >
          {row.map((child, itemIndex) => (
            <View
              key={itemIndex}
              style={{
                width: itemWidth,
                marginRight: itemIndex < row.length - 1 ? spacing : 0,
              }}
            >
              {child}
            </View>
          ))}

          {/* Fill remaining space if row is not full */}
          {row.length < columns && (
            [...Array(columns - row.length)].map((_, emptyIndex) => (
              <View
                key={\`empty-\${emptyIndex}\`}
                style={{
                  width: itemWidth,
                  marginRight: emptyIndex < columns - row.length - 1 ? spacing : 0
                }}
              />
            ))
          )}
        </View>
      ))}
    </ScrollView>
  )
}
\`\`\`

