## Real-Time Data Architecture with Convex

### Revolutionary Reactive Backend

Convex represents a paradigm shift in how we think about backend architecture. Unlike traditional backends that require complex setup for real-time features, Convex is built from the ground up with reactivity as a core principle.

**Core Architecture Principles:**

```typescript
// convex/messages.ts - Define your data model
import { v } from "convex/values";
import { mutation, query } from "./_generated/server";

// Reactive query - automatically updates all connected clients
export const list = query({
  args: { channelId: v.id("channels") },
  handler: async (ctx, { channelId }) => {
    const messages = await ctx.db
      .query("messages")
      .withIndex("by_channel", (q) => q.eq("channelId", channelId))
      .order("desc")
      .take(50);

    return messages.reverse();
  }
});

// Mutation with automatic optimistic updates
export const send = mutation({
  args: {
    channelId: v.id("channels"),
    text: v.string(),
    userId: v.id("users")
  },
  handler: async (ctx, { channelId, text, userId }) => {
    const messageId = await ctx.db.insert("messages", {
      channelId,
      text,
      userId,
      createdAt: Date.now()
    });

    // Trigger real-time update to all subscribers
    return messageId;
  }
});
```

**Frontend Integration with Automatic Reactivity:**

```tsx
// app/chat/[channelId]/page.tsx
'use client';
import { useQuery, useMutation } from "convex/react";
import { api } from "@/convex/_generated/api";
import { Id } from "@/convex/_generated/dataModel";

export default function ChatChannel({ params }: { params: { channelId: string } }) {
  const channelId = params.channelId as Id<"channels">;

  // Automatically reactive - updates when new messages arrive
  const messages = useQuery(api.messages.list, { channelId });
  const sendMessage = useMutation(api.messages.send);

  const handleSend = async (text: string) => {
    await sendMessage({
      channelId,
      text,
      userId: "user_123" as Id<"users">
    });
  };

  return (
    <div className="flex flex-col h-full">
      <div className="flex-1 overflow-y-auto">
        {messages?.map((message) => (
          <div key={message._id} className="p-4 border-b">
            <p>{message.text}</p>
            <small>{new Date(message.createdAt).toLocaleTimeString()}</small>
          </div>
        ))}
      </div>

      <MessageInput onSend={handleSend} />
    </div>
  );
}
```

### Advanced Convex Patterns

**Complex Queries with Relationships:**

```typescript
// convex/posts.ts - Advanced query patterns
export const getPostsWithAuthors = query({
  args: { limit: v.optional(v.number()) },
  handler: async (ctx, { limit = 10 }) => {
    const posts = await ctx.db
      .query("posts")
      .withIndex("by_published", (q) => q.eq("published", true))
      .order("desc")
      .take(limit);

    // Efficiently fetch related data
    return Promise.all(
      posts.map(async (post) => ({
        ...post,
        author: await ctx.db.get(post.authorId),
        commentCount: await ctx.db
          .query("comments")
          .withIndex("by_post", (q) => q.eq("postId", post._id))
          .collect()
          .then(comments => comments.length)
      }))
    );
  }
});

// Scheduled functions for background processing
export const processAnalytics = internalMutation({
  args: {},
  handler: async (ctx) => {
    const posts = await ctx.db.query("posts").collect();

    for (const post of posts) {
      const views = await ctx.db
        .query("page_views")
        .withIndex("by_post", (q) => q.eq("postId", post._id))
        .collect();

      await ctx.db.patch(post._id, {
        viewCount: views.length,
        lastAnalyticsUpdate: Date.now()
      });
    }
  }
});
```

**File Storage Integration:**

```typescript
// convex/files.ts - File upload handling
export const generateUploadUrl = mutation({
  args: {},
  handler: async (ctx) => {
    return await ctx.storage.generateUploadUrl();
  }
});

export const createPost = mutation({
  args: {
    title: v.string(),
    content: v.string(),
    imageStorageId: v.optional(v.id("_storage"))
  },
  handler: async (ctx, { title, content, imageStorageId }) => {
    let imageUrl = null;

    if (imageStorageId) {
      imageUrl = await ctx.storage.getUrl(imageStorageId);
    }

    return await ctx.db.insert("posts", {
      title,
      content,
      imageUrl,
      imageStorageId,
      createdAt: Date.now(),
      published: true
    });
  }
});
```

## Modern Authentication with Better Auth

### Developer-First Authentication Architecture

Better Auth has gained massive traction (300k+ weekly downloads) by focusing on developer experience while maintaining enterprise-grade security. Unlike traditional authentication libraries that require extensive configuration, Better Auth provides sensible defaults with powerful customization options.

**Core Setup and Configuration:**

```typescript
// lib/auth.ts - Better Auth configuration
import { betterAuth } from "better-auth";
import { prismaAdapter } from "better-auth/adapters/prisma";
import { nextCookies } from "better-auth/next-js";
import {
  twoFactor,
  emailOTP,
  organization,
  multiSession
} from "better-auth/plugins";

export const auth = betterAuth({
  database: prismaAdapter(prisma, {
    provider: "postgresql"
  }),

  // Email configuration with Resend
  emailAndPassword: {
    enabled: true,
    requireEmailVerification: true,
    sendResetPassword: async ({ user, url }) => {
      await resend.emails.send({
        from: "noreply@yourapp.com",
        to: user.email,
        subject: "Reset your password",
        html: \`<a href="\${url}">Reset Password</a>\`
      });
    }
  },

  // Social authentication
  socialProviders: {
    google: {
      clientId: process.env.GOOGLE_CLIENT_ID!,
      clientSecret: process.env.GOOGLE_CLIENT_SECRET!
    },
    github: {
      clientId: process.env.GITHUB_CLIENT_ID!,
      clientSecret: process.env.GITHUB_CLIENT_SECRET!
    }
  },

  // Advanced plugins
  plugins: [
    twoFactor(),
    emailOTP(),
    organization(),
    multiSession({
      maximumSessions: 5
    })
  ],

  // Custom session management
  session: {
    expiresIn: 60 * 60 * 24 * 7, // 7 days
    updateAge: 60 * 60 * 24, // 1 day
    cookieCache: {
      enabled: true,
      maxAge: 60 * 5 // 5 minutes
    }
  }
});

export type Session = typeof auth.$Infer.Session;
export type User = typeof auth.$Infer.User;
```

**Next.js App Router Integration:**

```tsx
// app/auth/signin/page.tsx - Modern sign-in page
'use client';
import { signIn } from "@/lib/auth-client";
import { useState } from "react";
import { useRouter } from "next/navigation";

export default function SignInPage() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [isLoading, setIsLoading] = useState(false);
  const router = useRouter();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsLoading(true);

    try {
      await signIn.emailAndPassword({
        email,
        password
      });

      router.push("/dashboard");
    } catch (error) {
      console.error("Sign in failed:", error);
    } finally {
      setIsLoading(false);
    }
  };

  const handleGoogleSignIn = async () => {
    await signIn.social({
      provider: "google",
      callbackURL: "/dashboard"
    });
  };

  return (
    <div className="max-w-md mx-auto mt-8">
      <form onSubmit={handleSubmit} className="space-y-4">
        <input
          type="email"
          value={email}
          onChange={(e) => setEmail(e.target.value)}
          placeholder="Email"
          className="w-full p-3 border rounded-lg"
          required
        />

        <input
          type="password"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
          placeholder="Password"
          className="w-full p-3 border rounded-lg"
          required
        />

        <button
          type="submit"
          disabled={isLoading}
          className="w-full bg-blue-600 text-white p-3 rounded-lg hover:bg-blue-700 disabled:opacity-50"
        >
          {isLoading ? "Signing in..." : "Sign In"}
        </button>
      </form>

      <div className="mt-4">
        <button
          onClick={handleGoogleSignIn}
          className="w-full bg-gray-100 text-gray-800 p-3 rounded-lg hover:bg-gray-200"
        >
          Continue with Google
        </button>
      </div>
    </div>
  );
}
```

**Advanced Authentication Patterns:**

```tsx
// lib/auth-client.ts - Client-side auth utilities
import { createAuthClient } from "better-auth/client";
import { organizationClient, twoFactorClient } from "better-auth/client/plugins";

export const authClient = createAuthClient({
  baseURL: process.env.NEXT_PUBLIC_APP_URL,
  plugins: [
    organizationClient(),
    twoFactorClient()
  ]
});

export const {
  signIn,
  signUp,
  signOut,
  useSession,
  user,
  organization
} = authClient;

// Custom hook for protected routes
export function useRequireAuth() {
  const { data: session, isLoading } = useSession();
  const router = useRouter();

  useEffect(() => {
    if (!isLoading && !session) {
      router.push("/auth/signin");
    }
  }, [session, isLoading, router]);

  return { session, isLoading };
}

// Organization management
export async function createOrganization(name: string) {
  return await organization.create({
    name,
    slug: name.toLowerCase().replace(/\s+/g, "-")
  });
}

export async function inviteUser(email: string, role: "admin" | "member") {
  return await organization.inviteUser({
    email,
    role,
    organizationId: "current"
  });
}
