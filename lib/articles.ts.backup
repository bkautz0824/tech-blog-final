**Advanced R3F Hooks and State Management**
\`\`\`typescript
// Custom R3F Hooks for Complex 3D Interactions
import { useThree, useFrame } from '@react-three/fiber'
import { useSpring, animated } from '@react-spring/three'

// 3D Camera Controller Hook
export function use3DCameraController() {
  const { camera } = useThree()
  const [cameraState, setCameraState] = useState({
    position: [0, 0, 10] as [number, number, number],
    target: [0, 0, 0] as [number, number, number],
    fov: 45
  })

  const animatedCamera = useSpring({
    position: cameraState.position,
    config: { tension: 120, friction: 20 }
  })

  const moveCameraTo = useCallback((
    position: [number, number, number],
    target?: [number, number, number],
    duration = 1000
  ) => {
    setCameraState(prev => ({
      ...prev,
      position,
      target: target || prev.target
    }))
  }, [])

  const setCameraPreset = useCallback((preset: string) => {
    const presets = {
      'overview': { position: [0, 10, 10], target: [0, 0, 0] },
      'close-up': { position: [2, 2, 5], target: [0, 0, 0] },
      'side': { position: [10, 0, 0], target: [0, 0, 0] },
      'top': { position: [0, 15, 0], target: [0, 0, 0] }
    }

    const config = presets[preset as keyof typeof presets]
    if (config) {
      moveCameraTo(config.position, config.target)
    }
  }, [moveCameraTo])

  useFrame(() => {
    camera.position.lerp(
      new THREE.Vector3(...animatedCamera.position.get()),
      0.05
    )
    camera.lookAt(new THREE.Vector3(...cameraState.target))
  })

  return {
    moveCameraTo,
    setCameraPreset,
    cameraState,
    animatedCamera
  }
}

// 3D Physics Integration Hook
export function use3DPhysics(initialObjects: PhysicsObject[]) {
  const [objects, setObjects] = useState(initialObjects)
  const [physicsWorld] = useState(() => new PhysicsWorld())

  const addPhysicsObject = useCallback((object: PhysicsObject) => {
    physicsWorld.addBody(object.body)
    setObjects(prev => [...prev, object])
  }, [physicsWorld])

  const removePhysicsObject = useCallback((id: string) => {
    const object = objects.find(obj => obj.id === id)
    if (object) {
      physicsWorld.removeBody(object.body)
      setObjects(prev => prev.filter(obj => obj.id !== id))
    }
  }, [objects, physicsWorld])

  const applyForce = useCallback((id: string, force: [number, number, number]) => {
    const object = objects.find(obj => obj.id === id)
    if (object) {
      object.body.applyImpulse(new THREE.Vector3(...force))
    }
  }, [objects])

  useFrame((state, delta) => {
    physicsWorld.step(delta)

    // Update object positions from physics simulation
    objects.forEach(object => {
      object.mesh.position.copy(object.body.position)
      object.mesh.quaternion.copy(object.body.quaternion)
    })
  })

  return {
    objects,
    addPhysicsObject,
    removePhysicsObject,
    applyForce,
    physicsWorld
  }
}
\`\`\`

## WebGL Performance and Optimization

### Advanced Performance Optimization Techniques

WebGL performance optimization is crucial for delivering smooth 3D experiences across devices and browsers. Modern optimization strategies focus on GPU utilization, memory management, and adaptive quality scaling.

**GPU-Optimized Rendering Pipeline**
\`\`\`typescript
// Advanced WebGL Performance Optimization
class WebGLPerformanceManager {
  private renderer: THREE.WebGLRenderer
  private stats: Stats
  private performanceMetrics: PerformanceMetrics
  private adaptiveQuality: AdaptiveQualityController

  constructor(renderer: THREE.WebGLRenderer) {
    this.renderer = renderer
    this.stats = new Stats()
    this.performanceMetrics = new PerformanceMetrics()
    this.adaptiveQuality = new AdaptiveQualityController(renderer)

    this.initializeOptimizations()
  }

  initializeOptimizations() {
    // Configure renderer for optimal performance
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
    this.renderer.shadowMap.enabled = true
    this.renderer.shadowMap.type = THREE.PCFSoftShadowMap

    // Enable WebGL extensions
    const extensions = [
      'EXT_texture_filter_anisotropic',
      'OES_texture_float',
      'WEBGL_depth_texture',
      'OES_element_index_uint'
    ]

    extensions.forEach(ext => {
      const extension = this.renderer.getContext().getExtension(ext)
      if (extension) {
        console.log(\`Enabled extension: \${ext}\`)
      }
    })

    // Memory management
    this.setupMemoryManagement()

    // Performance monitoring
    this.setupPerformanceMonitoring()
  }

  setupMemoryManagement() {
    // Automatic garbage collection for textures and geometries
    const disposeTracker = new WeakSet()

    const originalDispose = THREE.Material.prototype.dispose
    THREE.Material.prototype.dispose = function() {
      if (!disposeTracker.has(this)) {
        disposeTracker.add(this)
        originalDispose.call(this)
      }
    }

    // Texture pooling system
    this.texturePool = new TexturePool()

    // Geometry instancing for repeated objects
    this.geometryInstanceManager = new GeometryInstanceManager()
  }

  setupPerformanceMonitoring() {
    const monitor = () => {
      const info = this.renderer.info

      this.performanceMetrics.update({
        drawCalls: info.render.calls,
        triangles: info.render.triangles,
        points: info.render.points,
        lines: info.render.lines,
        geometries: info.memory.geometries,
        textures: info.memory.textures,
        fps: this.stats.getFPS()
      })

      // Trigger adaptive quality adjustments
      this.adaptiveQuality.update(this.performanceMetrics)

      requestAnimationFrame(monitor)
    }

    monitor()
  }
}

// Adaptive Quality System
class AdaptiveQualityController {
  private renderer: THREE.WebGLRenderer
  private targetFPS = 60
  private qualityLevels = [
    { name: 'ultra', pixelRatio: 2.0, shadowMapSize: 2048, antialiasing: true },
    { name: 'high', pixelRatio: 1.5, shadowMapSize: 1024, antialiasing: true },
    { name: 'medium', pixelRatio: 1.0, shadowMapSize: 512, antialiasing: false },
    { name: 'low', pixelRatio: 0.75, shadowMapSize: 256, antialiasing: false }
  ]
  private currentQualityIndex = 1

  constructor(renderer: THREE.WebGLRenderer) {
    this.renderer = renderer
  }

  update(metrics: PerformanceMetrics) {
    const avgFPS = metrics.getAverageFPS()

    if (avgFPS < this.targetFPS * 0.8 && this.currentQualityIndex < this.qualityLevels.length - 1) {
      // Decrease quality
      this.currentQualityIndex++
      this.applyQualitySettings(this.qualityLevels[this.currentQualityIndex])
    } else if (avgFPS > this.targetFPS * 0.95 && this.currentQualityIndex > 0) {
      // Increase quality
      this.currentQualityIndex--
      this.applyQualitySettings(this.qualityLevels[this.currentQualityIndex])
    }
  }

  applyQualitySettings(quality: QualityLevel) {
    this.renderer.setPixelRatio(quality.pixelRatio)

    if (this.renderer.shadowMap) {
      this.renderer.shadowMap.enabled = quality.shadowMapSize > 0
      // Update shadow map size for all lights
      this.updateShadowMapSize(quality.shadowMapSize)
    }

    console.log(\`Quality adjusted to: \${quality.name}\`)
  }

  updateShadowMapSize(size: number) {
    // This would be called on all shadow-casting lights in the scene
    // Implementation depends on scene management architecture
  }
}

// Optimized Object Pooling
class ObjectPool<T> {
  private pool: T[] = []
  private createFn: () => T
  private resetFn: (obj: T) => void

  constructor(createFn: () => T, resetFn: (obj: T) => void, initialSize = 10) {
    this.createFn = createFn
    this.resetFn = resetFn

    // Pre-populate pool
    for (let i = 0; i < initialSize; i++) {
      this.pool.push(this.createFn())
    }
  }

  acquire(): T {
    const obj = this.pool.pop() || this.createFn()
    return obj
  }

  release(obj: T) {
    this.resetFn(obj)
    this.pool.push(obj)
  }

  size(): number {
    return this.pool.length
  }
}

// Usage: Particle System with Object Pooling
class OptimizedParticleSystem {
  private particlePool: ObjectPool<ParticleObject>
  private activeParticles: ParticleObject[] = []
  private geometry: THREE.InstancedBufferGeometry
  private material: THREE.ShaderMaterial

  constructor(maxParticles = 1000) {
    // Initialize object pool
    this.particlePool = new ObjectPool(
      () => new ParticleObject(),
      (particle) => particle.reset(),
      Math.min(maxParticles, 100)
    )

    this.setupInstancedGeometry(maxParticles)
    this.setupShaderMaterial()
  }

  setupInstancedGeometry(maxParticles: number) {
    this.geometry = new THREE.InstancedBufferGeometry()

    // Base geometry (shared by all instances)
    const baseGeometry = new THREE.PlaneGeometry(0.1, 0.1)
    this.geometry.index = baseGeometry.index
    this.geometry.attributes.position = baseGeometry.attributes.position
    this.geometry.attributes.uv = baseGeometry.attributes.uv

    // Instance attributes
    const positions = new Float32Array(maxParticles * 3)
    const scales = new Float32Array(maxParticles)
    const rotations = new Float32Array(maxParticles)
    const colors = new Float32Array(maxParticles * 3)

    this.geometry.setAttribute('instancePosition', new THREE.InstancedBufferAttribute(positions, 3))
    this.geometry.setAttribute('instanceScale', new THREE.InstancedBufferAttribute(scales, 1))
    this.geometry.setAttribute('instanceRotation', new THREE.InstancedBufferAttribute(rotations, 1))
    this.geometry.setAttribute('instanceColor', new THREE.InstancedBufferAttribute(colors, 3))
  }

  emitParticle(position: THREE.Vector3, velocity: THREE.Vector3, lifetime: number) {
    const particle = this.particlePool.acquire()
    particle.initialize(position, velocity, lifetime)
    this.activeParticles.push(particle)
  }

  update(deltaTime: number) {
    // Update active particles
    for (let i = this.activeParticles.length - 1; i >= 0; i--) {
      const particle = this.activeParticles[i]
      particle.update(deltaTime)

      if (particle.isDead()) {
        // Return to pool
        this.particlePool.release(particle)
        this.activeParticles.splice(i, 1)
      }
    }

    // Update instanced attributes
    this.updateInstancedAttributes()
  }

  updateInstancedAttributes() {
    const positionAttr = this.geometry.attributes.instancePosition as THREE.InstancedBufferAttribute
    const scaleAttr = this.geometry.attributes.instanceScale as THREE.InstancedBufferAttribute
    const rotationAttr = this.geometry.attributes.instanceRotation as THREE.InstancedBufferAttribute
    const colorAttr = this.geometry.attributes.instanceColor as THREE.InstancedBufferAttribute

    this.activeParticles.forEach((particle, i) => {
      // Update position
      positionAttr.setXYZ(i, particle.position.x, particle.position.y, particle.position.z)

      // Update scale
      scaleAttr.setX(i, particle.scale)

      // Update rotation
      rotationAttr.setX(i, particle.rotation)

      // Update color
      colorAttr.setXYZ(i, particle.color.r, particle.color.g, particle.color.b)
    })

    positionAttr.needsUpdate = true
    scaleAttr.needsUpdate = true
    rotationAttr.needsUpdate = true
    colorAttr.needsUpdate = true

    // Set instance count
    this.geometry.instanceCount = this.activeParticles.length
  }
}
\`\`\`

## Interactive 3D Experiences and Storytelling

### Narrative-Driven 3D Interfaces

Modern 3D web experiences go beyond technical showcases to become powerful storytelling mediums. By combining spatial design, temporal animations, and interactive elements, developers can create immersive narratives that engage users on emotional and intellectual levels.

**3D Storytelling Framework**
\`\`\`typescript
// Interactive 3D Storytelling System
interface StoryChapter {
  id: string
  title: string
  duration: number
  scenes: StoryScene[]
  transitions: SceneTransition[]
  interactiveElements: InteractiveElement[]
  voiceNarration?: AudioClip
  backgroundMusic?: AudioClip
}

interface StoryScene {
  id: string
  cameraPosition: [number, number, number]
  cameraTarget: [number, number, number]
  objects: SceneObject[]
  lighting: LightingSetup
  effects: VisualEffect[]
}

class Interactive3DStory {
  private chapters: StoryChapter[]
  private currentChapterIndex = 0
  private currentSceneIndex = 0
  private isPlaying = false
  private userInteractionEnabled = true

  constructor(storyConfig: StoryConfig) {
    this.chapters = storyConfig.chapters
    this.setupEventListeners()
  }

  async playChapter(chapterIndex: number) {
    if (chapterIndex >= this.chapters.length) return

    this.currentChapterIndex = chapterIndex
    this.currentSceneIndex = 0
    const chapter = this.chapters[chapterIndex]

    // Preload chapter assets
    await this.preloadChapterAssets(chapter)

    // Start chapter narration
    if (chapter.voiceNarration) {
      this.playAudio(chapter.voiceNarration)
    }

    if (chapter.backgroundMusic) {
      this.playBackgroundMusic(chapter.backgroundMusic)
    }

    // Play scenes in sequence
    for (const scene of chapter.scenes) {
      await this.playScene(scene)

      // Wait for user interaction or auto-advance
      await this.waitForSceneCompletion(scene)
    }
  }

  async playScene(scene: StoryScene) {
    return new Promise<void>((resolve) => {
      // Animate camera to scene position
      this.animateCamera(
        scene.cameraPosition,
        scene.cameraTarget,
        2000 // 2 second transition
      ).then(() => {
        // Setup scene objects
        this.setupSceneObjects(scene.objects)

        // Configure lighting
        this.setupLighting(scene.lighting)

        // Apply visual effects
        scene.effects.forEach(effect => this.applyEffect(effect))

        resolve()
      })
    })
  }

  private async waitForSceneCompletion(scene: StoryScene): Promise<void> {
    return new Promise((resolve) => {
      if (scene.interactiveElements.length > 0) {
        // Wait for user interactions
        this.setupSceneInteractions(scene.interactiveElements, resolve)
      } else {
        // Auto-advance after scene duration
        setTimeout(resolve, scene.duration || 5000)
      }
    })
  }

  private setupSceneInteractions(elements: InteractiveElement[], onComplete: () => void) {
    let completedInteractions = 0
    const requiredInteractions = elements.filter(el => el.required).length

    elements.forEach(element => {
      const object3D = this.findObjectById(element.objectId)
      if (!object3D) return

      const handleInteraction = () => {
        // Execute interaction effect
        this.executeInteractionEffect(element.effect)

        if (element.required) {
          completedInteractions++
          if (completedInteractions >= requiredInteractions) {
            onComplete()
          }
        }
      }

      // Add interaction listeners
      object3D.addEventListener('click', handleInteraction)
      object3D.addEventListener('hover', () => {
        this.showInteractionHint(element.hintText)
      })
    })
  }
}

// React Component for Interactive 3D Stories
export function Interactive3DStoryViewer({ storyId }: { storyId: string }) {
  const [story, setStory] = useState<Interactive3DStory | null>(null)
  const [currentChapter, setCurrentChapter] = useState(0)
  const [isLoading, setIsLoading] = useState(true)
  const [userChoices, setUserChoices] = useState<Record<string, any>>({})

  useEffect(() => {
    loadStory(storyId).then(storyConfig => {
      const storyInstance = new Interactive3DStory(storyConfig)
      setStory(storyInstance)
      setIsLoading(false)
    })
  }, [storyId])

  const handleUserChoice = useCallback((choiceId: string, value: any) => {
    setUserChoices(prev => ({
      ...prev,
      [choiceId]: value
    }))

    // Update story progression based on choice
    story?.processUserChoice(choiceId, value)
  }, [story])

  if (isLoading) {
    return <StoryLoadingScreen />
  }

  return (
    <div className="relative w-full h-screen">
      {/* 3D Scene */}
      <Scene3D className="absolute inset-0">
        <StorySceneContent
          story={story}
          currentChapter={currentChapter}
          onUserInteraction={handleUserChoice}
        />
      </Scene3D>

      {/* Story UI Overlay */}
      <StoryOverlayUI
        story={story}
        currentChapter={currentChapter}
        userChoices={userChoices}
        onChapterSelect={setCurrentChapter}
        onChoice={handleUserChoice}
      />

      {/* Progress Indicator */}
      <StoryProgressIndicator
        totalChapters={story?.getTotalChapters() || 0}
        currentChapter={currentChapter}
        className="absolute bottom-4 left-1/2 transform -translate-x-1/2"
      />
    </div>
  )
}
\`\`\`

## Conclusion

The 3D graphics and animation tools ecosystem for web development has reached unprecedented maturity and capability. From Spline's intuitive design-first workflow to React Three Fiber's powerful declarative 3D rendering, developers now have access to production-ready tools that can create immersive, performant 3D experiences that rival native applications.

Key developments in this space include advanced animation timeline systems that enable complex storytelling, sophisticated performance optimization techniques that ensure smooth rendering across devices, and comprehensive browser compatibility strategies that provide fallbacks for older browsers while leveraging cutting-edge features on modern platforms.

The integration of WebGL optimization, intelligent asset management, and adaptive quality systems has made it possible to deploy 3D web applications at scale. Whether you're building product showcases, interactive data visualizations, immersive storytelling experiences, or complex 3D games, the tools and techniques covered in this guide provide a solid foundation for creating engaging 3D web experiences.

As WebGPU adoption grows and browser 3D capabilities continue to expand, the future of 3D web development looks increasingly bright. The patterns and architectures outlined here will continue to evolve, but the fundamental principles of performance optimization, progressive enhancement, and user-centered design will remain central to creating successful 3D web applications.

The combination of powerful design tools, robust development frameworks, and optimized deployment strategies has democratized 3D web development, making it accessible to frontend developers while maintaining the performance and reliability required for production applications. This represents a significant milestone in the evolution of web technology and opens up new possibilities for creative, engaging user experiences.`,
