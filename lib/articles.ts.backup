### Cross-Team Integration Patterns

\`\`\`typescript
// Event-driven team integration
interface TeamIntegration {
  events: DomainEvent[];
  sharedContracts: APIContract[];
  communicationPatterns: CommunicationPattern[];
}

class InterTeamCommunication {
  async publishEvent(event: DomainEvent): Promise<void> {
    await this.eventBus.publish({
      type: event.type,
      data: event.payload,
      source: event.sourceTeam,
      timestamp: new Date(),
      correlationId: event.correlationId
    });
  }

  async subscribeToEvents(
    teamId: string,
    eventTypes: string[]
  ): Promise<EventSubscription> {
    return await this.eventBus.subscribe({
      subscriber: teamId,
      eventTypes,
      handler: this.createEventHandler(teamId)
    });
  }

  private createEventHandler(teamId: string) {
    return async (event: DomainEvent) => {
      const handler = this.teamHandlers.get(teamId);
      if (handler) {
        await handler.processEvent(event);
      }
    };
  }
}
\`\`\`

