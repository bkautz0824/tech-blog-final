#!/bin/bash
# setup-development-environment.sh

# Development environment automation
setup_dev_environment() {
  echo "Setting up full-stack development environment..."

  # Node.js and package managers
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
  nvm install 20
  nvm use 20
  npm install -g pnpm typescript tsx

  # Development tools
  brew install git gh
  gh extension install github/gh-copilot

  # Database tools
  brew install postgresql redis

  # Docker for local services
  brew install --cask docker

  # IDE extensions and configurations
  code --install-extension ms-vscode.vscode-typescript-next
  code --install-extension GitHub.copilot
  code --install-extension bradlc.vscode-tailwindcss
  code --install-extension Prisma.prisma

  echo "Development environment setup complete!"
}

# Project initialization
init_project() {
  local project_name=$1

  # Create project directory
  mkdir "$project_name"
  cd "$project_name"

  # Initialize Next.js project
  npx create-next-app@latest . --typescript --tailwind --eslint --app

  # Add development dependencies
  pnpm add -D @types/node @typescript-eslint/eslint-plugin @typescript-eslint/parser
  pnpm add -D prettier eslint-config-prettier eslint-plugin-prettier
  pnpm add -D husky lint-staged commitlint @commitlint/cli @commitlint/config-conventional
  pnpm add -D vitest @vitest/ui jsdom @testing-library/react @testing-library/jest-dom
  pnpm add -D playwright @playwright/test

  # Setup Git hooks
  npx husky install
  npx husky add .husky/pre-commit "pnpm lint-staged"
  npx husky add .husky/commit-msg "npx commitlint --edit"

  echo "Project initialized successfully!"
}
