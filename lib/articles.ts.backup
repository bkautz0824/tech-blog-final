## Spline Integration and Workflow Optimization

### Spline Design-to-Development Workflow

Spline has revolutionized 3D web development by providing a visual design environment that exports directly to web-ready code. This design-first approach enables rapid prototyping and iteration while maintaining production-quality output.

**Spline Project Setup and Organization**
\`\`\`typescript
// Spline Integration with React Applications
import Spline from '@splinetool/react-spline'
import { Application } from '@splinetool/runtime'
import { useCallback, useRef, useState } from 'react'

interface SplineSceneProps {
  scene: string // Spline scene URL or file path
  onLoad?: (app: Application) => void
  onProgress?: (progress: number) => void
  fallback?: React.ReactNode
  className?: string
}

export function SplineScene({
  scene,
  onLoad,
  onProgress,
  fallback,
  className = "w-full h-full"
}: SplineSceneProps) {
  const splineRef = useRef<Application>()
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  const handleLoad = useCallback((app: Application) => {
    splineRef.current = app
    setLoading(false)
    onLoad?.(app)

    // Set up event listeners for interactive elements
    app.addEventListener('mouseHover', (e) => {
      // Handle hover interactions
      console.log('Hovered object:', e.target.name)
    })

    app.addEventListener('mouseDown', (e) => {
      // Handle click interactions
      console.log('Clicked object:', e.target.name)
    })
  }, [onLoad])

  const handleProgress = useCallback((progress: number) => {
    onProgress?.(progress)
  }, [onProgress])

  const handleError = useCallback((error: any) => {
    setError(error.message)
    setLoading(false)
  }, [])

  // API for controlling Spline scene from React
  const controlSplineScene = useCallback((action: string, params?: any) => {
    if (!splineRef.current) return

    switch (action) {
      case 'playAnimation':
        splineRef.current.emitEvent('triggerAnimation', params?.animationName)
        break
      case 'updateMaterial':
        const object = splineRef.current.findObjectByName(params?.objectName)
        if (object && object.material) {
          object.material.color.setHex(params?.color)
        }
        break
      case 'moveObject':
        const targetObject = splineRef.current.findObjectByName(params?.objectName)
        if (targetObject) {
          targetObject.position.set(params?.x, params?.y, params?.z)
        }
        break
    }
  }, [])

  if (error) {
    return (
      <div className="flex items-center justify-center w-full h-full bg-gray-100 rounded-lg">
        <p className="text-red-600">Error loading 3D scene: {error}</p>
      </div>
    )
  }

  return (
    <div className={className} style={{ position: 'relative' }}>
      {loading && (
        <div className="absolute inset-0 flex items-center justify-center bg-gray-50 rounded-lg">
          {fallback || <LoadingSpinner />}
        </div>
      )}

      <Spline
        scene={scene}
        onLoad={handleLoad}
        onProgress={handleProgress}
        onError={handleError}
        style={{
          width: '100%',
          height: '100%',
          opacity: loading ? 0 : 1,
          transition: 'opacity 0.3s ease-in-out'
        }}
      />
    </div>
  )
}
\`\`\`

**Advanced Spline Event System**
\`\`\`typescript
// Spline Event-Driven Interactions
import { useSplineEvents } from './hooks/useSplineEvents'

function InteractiveSplineComponent() {
  const { app, events, controls } = useSplineEvents()

  // Complex interaction patterns
  const handleProductInteraction = useCallback((productId: string) => {
    // Trigger Spline animations
    controls.playAnimation(\`product-\${productId}-highlight\`)

    // Update UI state
    setSelectedProduct(productId)

    // Analytics tracking
    analytics.track('3d_product_interaction', { productId })
  }, [controls])

  const setupInteractiveHotspots = useCallback((app: Application) => {
    const hotspots = ['product-1', 'product-2', 'product-3']

    hotspots.forEach(hotspotId => {
      const hotspot = app.findObjectByName(hotspotId)
      if (hotspot) {
        // Add hover effects
        hotspot.addEventListener('mouseEnter', () => {
          controls.playAnimation(\`\${hotspotId}-hover-start\`)
        })

        hotspot.addEventListener('mouseLeave', () => {
          controls.playAnimation(\`\${hotspotId}-hover-end\`)
        })

        // Add click interactions
        hotspot.addEventListener('mouseDown', () => {
          handleProductInteraction(hotspotId.split('-')[1])
        })
      }
    })
  }, [controls, handleProductInteraction])

  return (
    <div className="relative w-full h-screen">
      <SplineScene
        scene="/assets/interactive-product-showcase.splinecode"
        onLoad={setupInteractiveHotspots}
        className="absolute inset-0"
      />

      {/* Overlay UI synchronized with 3D interactions */}
      <div className="absolute top-4 right-4 z-10">
        <ProductInfoPanel selectedProduct={selectedProduct} />
      </div>

      {/* 3D-synchronized controls */}
      <div className="absolute bottom-4 left-1/2 transform -translate-x-1/2 z-10">
        <SceneControls
          onCameraChange={(preset) => controls.setCameraPosition(preset)}
          onAnimationTrigger={(name) => controls.playAnimation(name)}
        />
      </div>
    </div>
  )
}
