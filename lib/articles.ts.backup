        color: '$gray700',
        '&:hover': {
          backgroundColor: '$gray100',
        },
      },
    },
    size: {
      sm: {
        height: '32px',
        paddingX: '$3',
        fontSize: '$sm',
      },
      md: {
        height: '40px',
        paddingX: '$4',
        fontSize: '$base',
      },
      lg: {
        height: '48px',
        paddingX: '$6',
        fontSize: '$lg',
      },
    },
    fullWidth: {
      true: {
        width: '100%',
      },
    },
    loading: {
      true: {
        color: 'transparent',
        '&::after': {
          content: '""',
