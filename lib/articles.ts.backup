## Common Pitfalls and Solutions

### 1. Model Selection and Cost Optimization

**Problem**: Choosing the wrong AI model for specific tasks leads to poor performance or excessive costs.

**Solutions**:
- **Task-specific model mapping**: Use lightweight models for simple tasks, powerful models for complex reasoning
- **Dynamic model selection**: Implement fallback strategies with OpenRouter AI
- **Cost monitoring**: Track usage patterns and optimize model selection

```typescript
// Intelligent model selection strategy
export class ModelOptimizer {
  private costThresholds = {
    simple: 0.001,    // per request
    moderate: 0.01,
    complex: 0.05
  };

  selectOptimalModel(task: AITask, budget: number): ModelConfig {
    const complexity = this.analyzeTaskComplexity(task);
    const urgency = task.urgency || 'normal';

    if (complexity === 'simple' && budget < this.costThresholds.moderate) {
      return {
        primary: 'openai/gpt-3.5-turbo',
        fallback: 'anthropic/claude-3-haiku',
        provider: 'openrouter'
      };
    }

    if (complexity === 'reasoning' || task.type === 'mathematical') {
      return {
        primary: 'mistral/magistral-1.2',
        fallback: 'openai/gpt-4-turbo',
        provider: 'magistral'
      };
    }

    return {
      primary: 'openai/gpt-4-turbo',
      fallback: 'anthropic/claude-3-opus',
      provider: 'openrouter'
    };
  }

  async executeWithOptimalModel(task: AITask) {
    const modelConfig = this.selectOptimalModel(task, task.budget);

    try {
      return await this.executeTask(task, modelConfig.primary);
    } catch (error) {
      if (this.shouldFallback(error)) {
        return await this.executeTask(task, modelConfig.fallback);
      }
      throw error;
    }
  }
}
```

### 2. Streaming and Real-Time Performance

**Problem**: Poor user experience due to slow AI response times and lack of streaming feedback.

**Solutions**:
- **Streaming-first architecture**: Use AI SDK's streaming capabilities for immediate feedback
- **Progressive enhancement**: Show intermediate results while processing continues
- **Response caching**: Cache common queries for instant responses

```typescript
// Optimized streaming implementation
export function useStreamingAI() {
  const [response, setResponse] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState(null);

  const streamResponse = async (prompt: string) => {
    setIsLoading(true);
    setError(null);
    setResponse('');

    try {
      const stream = await fetch('/api/ai/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt })
      });

      if (!stream.ok) throw new Error('Stream failed');

      const reader = stream.body?.getReader();
      if (!reader) throw new Error('No reader available');

      while (true) {
        const { done, value } = await reader.read();

        if (done) break;

        const chunk = new TextDecoder().decode(value);
        const lines = chunk.split('\n').filter(line => line.trim());

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            try {
              const data = JSON.parse(line.slice(6));
              if (data.content) {
                setResponse(prev => prev + data.content);
              }
            } catch (e) {
              // Handle parsing errors gracefully
              console.warn('Failed to parse stream chunk:', e);
            }
          }
        }
      }
    } catch (err) {
      setError(err);
    } finally {
      setIsLoading(false);
    }
  };

  return { response, isLoading, error, streamResponse };
}
```

### 3. Context Management and Memory

**Problem**: AI applications lose context between interactions, leading to repetitive or irrelevant responses.

**Solutions**:
- **Conversation memory systems**: Implement persistent context storage
- **Smart context windowing**: Maintain relevant context while managing token limits
- **Context compression**: Summarize old conversations to preserve memory

```typescript
// Advanced context management system
export class ConversationMemory {
  private redis: Redis;
  private contextWindow = 8000; // tokens
  private compressionThreshold = 12000;

  constructor(private userId: string) {
    this.redis = new Redis(process.env.REDIS_URL);
  }

  async getRelevantContext(currentMessage: string): Promise<Message[]> {
    // Retrieve full conversation history
    const fullHistory = await this.redis.get(`conversation:${this.userId}`);
    const history = fullHistory ? JSON.parse(fullHistory) : [];

    // If context is too large, compress older messages
    const totalTokens = this.estimateTokens(history);
    if (totalTokens > this.compressionThreshold) {
      history = await this.compressOldContext(history);
    }

    // Select most relevant messages based on semantic similarity
    const relevantMessages = await this.selectRelevantMessages(
      history,
      currentMessage,
      this.contextWindow
    );

    return relevantMessages;
  }

  private async compressOldContext(history: Message[]): Promise<Message[]> {
    // Keep recent messages, compress older ones
    const recentMessages = history.slice(-10);
    const oldMessages = history.slice(0, -10);

    if (oldMessages.length === 0) return recentMessages;

    // Compress old messages into a summary
    const summary = await this.summarizeMessages(oldMessages);

    return [
      { role: 'system', content: `Previous conversation summary: ${summary}` },
      ...recentMessages
    ];
  }

  private async selectRelevantMessages(
    history: Message[],
    currentMessage: string,
    maxTokens: number
  ): Promise<Message[]> {
    // Use semantic similarity to select most relevant messages
    const similarities = await Promise.all(
      history.map(async (msg) => ({
        message: msg,
        similarity: await this.calculateSimilarity(msg.content, currentMessage)
      }))
    );

    // Sort by relevance and recency
    const ranked = similarities
      .sort((a, b) => b.similarity - a.similarity)
      .map(item => item.message);

    // Add messages until we hit the token limit
    const selected: Message[] = [];
    let tokenCount = 0;

    for (const message of ranked) {
      const messageTokens = this.estimateTokens([message]);
      if (tokenCount + messageTokens <= maxTokens) {
        selected.push(message);
        tokenCount += messageTokens;
      }
    }

    return selected.sort((a, b) => a.timestamp - b.timestamp);
  }
}
```

## Best Practices for Production AI Applications

### 1. Error Handling and Resilience

Robust error handling is crucial for production AI applications, as AI services can be unpredictable.

```typescript
// Production-ready error handling
export class AIServiceManager {
  private retryConfig = {
    maxRetries: 3,
    backoffMultiplier: 2,
    initialDelay: 1000
  };

  async executeWithRetry<T>(
    operation: () => Promise<T>,
    context: string
  ): Promise<T> {
    let lastError: Error;

    for (let attempt = 0; attempt < this.retryConfig.maxRetries; attempt++) {
      try {
        return await operation();
      } catch (error) {
        lastError = error as Error;

        // Don't retry on certain error types
        if (this.isNonRetryableError(error)) {
          throw error;
        }

        // Log the attempt
        console.warn(`AI operation failed (attempt ${attempt + 1}/${this.retryConfig.maxRetries}):`, {
          context,
          error: error.message,
          attempt: attempt + 1
        });

        // Wait before retrying
        if (attempt < this.retryConfig.maxRetries - 1) {
          const delay = this.retryConfig.initialDelay *
            Math.pow(this.retryConfig.backoffMultiplier, attempt);
          await new Promise(resolve => setTimeout(resolve, delay));
        }
      }
    }

    // All retries failed
    throw new AIServiceError(
      \`AI operation failed after \${this.retryConfig.maxRetries} attempts\`,
      { context, originalError: lastError }
    );
  }

  private isNonRetryableError(error: any): boolean {
    // Don't retry on authentication, validation, or quota errors
    const nonRetryableCodes = [401, 403, 400, 429];
    return nonRetryableCodes.includes(error.status) ||
           error.message?.includes('quota exceeded');
  }
}
```

### 2. Performance Monitoring and Analytics

Monitor AI performance to optimize costs and user experience.

```typescript
// AI performance monitoring system
export class AIAnalytics {
  private metrics: Map<string, PerformanceMetric> = new Map();

  trackAIRequest(
    operation: string,
    model: string,
    duration: number,
    tokenUsage: TokenUsage,
    cost: number
  ) {
    const key = \`\${operation}:\${model}\`;
    const existing = this.metrics.get(key) || {
      count: 0,
      totalDuration: 0,
      totalTokens: 0,
      totalCost: 0,
      avgDuration: 0,
      avgTokens: 0,
      avgCost: 0
    };

    existing.count++;
    existing.totalDuration += duration;
    existing.totalTokens += tokenUsage.total;
    existing.totalCost += cost;
    existing.avgDuration = existing.totalDuration / existing.count;
    existing.avgTokens = existing.totalTokens / existing.count;
    existing.avgCost = existing.totalCost / existing.count;

    this.metrics.set(key, existing);

    // Send to analytics service
    this.sendToAnalytics({
      operation,
      model,
      duration,
      tokens: tokenUsage.total,
      cost,
      timestamp: Date.now()
    });
  }

  getPerformanceReport(): PerformanceReport {
    const reports = Array.from(this.metrics.entries()).map(([key, metric]) => {
      const [operation, model] = key.split(':');
      return { operation, model, ...metric };
    });

    return {
      totalRequests: reports.reduce((sum, r) => sum + r.count, 0),
      totalCost: reports.reduce((sum, r) => sum + r.totalCost, 0),
      avgResponseTime: reports.reduce((sum, r) => sum + r.avgDuration, 0) / reports.length,
      modelUsage: this.groupBy(reports, 'model'),
      operationStats: this.groupBy(reports, 'operation')
    };
  }
}
```

### 3. Security and Content Safety

Implement robust security measures for AI applications.

```typescript
// AI security and content moderation
export class AISecurityManager {
  private contentModerator: ContentModerator;
  private rateLimiter: RateLimiter;

  async validateAndSanitize(input: string, userId: string): Promise<ValidationResult> {
    // Rate limiting
    await this.rateLimiter.checkLimit(userId);

    // Content validation
    const moderationResult = await this.contentModerator.moderate(input);

    if (moderationResult.blocked) {
      throw new ContentViolationError(
        'Input contains inappropriate content',
        moderationResult.categories
      );
    }

    // Input sanitization
    const sanitizedInput = this.sanitizeInput(input);

    // PII detection and redaction
    const piiResult = await this.detectPII(sanitizedInput);
    const finalInput = this.redactPII(sanitizedInput, piiResult);

    return {
      sanitizedInput: finalInput,
      moderationScore: moderationResult.score,
      piiDetected: piiResult.detected,
      warnings: moderationResult.warnings
    };
  }

  async validateOutput(output: string): Promise<string> {
    // Scan output for potential issues
    const issues = await Promise.all([
      this.checkForHallucinations(output),
      this.checkForSensitiveInfo(output),
      this.checkForBias(output)
    ]);

    const allIssues = issues.flat();

    if (allIssues.length > 0) {
      // Log issues for monitoring
      console.warn('AI output issues detected:', allIssues);

      // Apply corrections
      return await this.correctOutput(output, allIssues);
    }

    return output;
  }

  private sanitizeInput(input: string): string {
    // Remove potentially harmful content
    return input
      .replace(/javascript:/gi, '')
      .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
      .replace(/on\w+\s*=\s*["'][^"']*["']/gi, '')
      .trim();
  }
}
```

## Real-World Implementation Examples

### Example 1: AI-Powered Customer Service Platform

A complete customer service platform using multiple AI tools for ticket routing, response generation, and sentiment analysis.

```typescript
// Complete customer service AI platform
export class CustomerServiceAI {
  private aiSDK: VercelAI;
  private workforce: EigentWorkforce;
  private voiceProcessor: ElevenLabs;
  private analytics: AIAnalytics;

  async processCustomerTicket(ticket: SupportTicket): Promise<TicketResolution> {
    // Step 1: Analyze ticket sentiment and urgency
    const analysis = await this.aiSDK.analyze({
      text: ticket.message,
      analyses: ['sentiment', 'urgency', 'category', 'intent']
    });

    // Step 2: Route to appropriate agent based on analysis
    const routingDecision = await this.routeTicket(ticket, analysis);

    // Step 3: Generate initial response
    const response = await this.generateResponse(ticket, analysis, routingDecision);

    // Step 4: If escalation needed, involve human agent
    if (analysis.urgency === 'high' || analysis.sentiment.score < -0.7) {
      await this.escalateToHuman(ticket, analysis, response);
    }

    // Step 5: Track performance
    this.analytics.trackCustomerInteraction({
      ticketId: ticket.id,
      category: analysis.category,
      sentiment: analysis.sentiment,
      responseTime: Date.now() - ticket.createdAt,
      resolution: response.resolution
    });

    return {
      response: response.message,
      category: analysis.category,
      urgency: analysis.urgency,
      nextActions: response.nextActions,
      escalated: analysis.urgency === 'high'
    };
  }

  private async routeTicket(
    ticket: SupportTicket,
    analysis: TicketAnalysis
  ): Promise<RoutingDecision> {
    // Use AI workforce to determine best routing
    const router = await this.workforce.getAgent('ticket-router');

    const decision = await router.process({
      ticket: ticket,
      analysis: analysis,
      availableAgents: await this.getAvailableAgents(),
      businessRules: await this.getRoutingRules()
    });

    return decision;
  }
}
```

### Example 2: Content Creation and Marketing Platform

An end-to-end content creation platform using multiple AI services for comprehensive marketing campaigns.

```typescript
// Comprehensive content marketing platform
export class ContentMarketingPlatform {
  private textGenerator: VercelAI;
  private imageGenerator: NanoBanana;
  private videoGenerator: LumaRay3;
  private voiceGenerator: ElevenLabs;
  private designGenerator: Gamma;

  async createMarketingCampaign(brief: MarketingBrief): Promise<Campaign> {
    // Generate campaign strategy
    const strategy = await this.generateStrategy(brief);

    // Create content assets in parallel
    const [textContent, visualAssets, audioContent, presentations] = await Promise.all([
      this.generateTextContent(strategy),
      this.generateVisualContent(strategy),
      this.generateAudioContent(strategy),
      this.generatePresentations(strategy)
    ]);

    // Optimize content for different platforms
    const platformContent = await this.optimizeForPlatforms({
      text: textContent,
      visuals: visualAssets,
      audio: audioContent,
      presentations: presentations
    });

    // Generate campaign analytics and tracking
    const tracking = await this.setupCampaignTracking(strategy);

    return {
      id: generateCampaignId(),
      strategy: strategy,
      content: platformContent,
      tracking: tracking,
      estimatedReach: await this.calculateReach(strategy),
      timeline: this.generateTimeline(strategy),
      budget: this.calculateBudget(strategy)
    };
  }

  private async generateTextContent(strategy: CampaignStrategy): Promise<TextContent> {
    const prompts = this.createContentPrompts(strategy);

    const content = await Promise.all(
      prompts.map(async (prompt) => {
        return await this.textGenerator.generate({
          prompt: prompt.text,
          style: prompt.style,
          audience: strategy.targetAudience,
          tone: strategy.brandVoice,
          constraints: {
            length: prompt.maxLength,
            keywords: strategy.keywords,
            callToAction: strategy.cta
          }
        });
      })
    );

    return this.organizeTextContent(content);
  }

  private async generateVisualContent(strategy: CampaignStrategy): Promise<VisualAssets> {
    const imagePrompts = this.createImagePrompts(strategy);

    const images = await Promise.all(
      imagePrompts.map(async (prompt) => {
        return await this.imageGenerator.generate({
          prompt: prompt.description,
          style: strategy.visualStyle,
          dimensions: prompt.dimensions,
          brandColors: strategy.brandColors,
          variations: 3
        });
      })
    );

    // Generate videos for key pieces
    const videos = await Promise.all(
      strategy.videoRequirements.map(async (requirement) => {
        return await this.videoGenerator.create({
          prompt: requirement.description,
          duration: requirement.duration,
          style: strategy.visualStyle,
          resolution: requirement.quality
        });
      })
    );

    return { images, videos };
  }
}
```

